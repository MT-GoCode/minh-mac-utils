# =====================================================================
# minh-mac-utils — keep the repo "just source". Build outputs + secrets are
# regenerated/scaffolded by each tool's installer on the target Mac.
# NOTE: git does NOT support inline comments — every comment is on its own line.
# =====================================================================

# ---------- common ----------
.DS_Store
*.pyc
__pycache__/
*.o
*.swiftmodule
*.swiftdoc

# never commit secrets, anywhere (defense in depth)
**/.env
**/credentials
**/Allpassword
*.pem
*.key

# ---------- demonlock (Swift) ----------
demonlock/.build/
demonlock/Demonlock.app/
# (demonlock/dist/Demonlock.app IS committed on purpose: Developer-ID-signed,
#  no secrets, lets a toolchain-less Mac install by copy. Rebuilt when you have Xcode.)

#  no secrets, lets a toolchain-less Mac install by copy. Rebuilt when you have Xcode.)

# ---------- wtalk (Python) ----------
wtalk/.venv/
wtalk/wtalk.app/
wtalk/.serve.pid
# Nuitka build outputs (the frozen app is rebuilt on the target Mac by install/build.sh)
wtalk/dist/
wtalk/wtalk.build/
wtalk/wtalk.dist/
wtalk/wtalk.onefile-build/
# secrets/data now live in ~/.wtalk, never the repo; the old repo .env is retired
wtalk/.env

# ---------- nextdns-sidecar (Swift; merges the retired nextdns-discipline + nextdns-lockdown) ----------
nextdns-sidecar/.build/

# ---------- betterat (bash) ----------
# Pure source — nothing to ignore. Runtime state + credentials live OUTSIDE the repo:
#   ~/.local/share/betterat/betterat.db
#   /usr/local/etc/nextdns-sidecar/credentials  (NextDNS Profile ID + API key)

# personal scratch (zone names) — never commit
demonlock/yourpolicies.txt

# ---------- remote-agent-connector (Swift, successor to foreman-uplink) ----------
remote-agent-connector/RemoteAgentConnector.app/

# ---------- msv2 / stayup (Swift) ----------
msv2/.build/
msv2/build/
stayup/.build/
stayup/build/
