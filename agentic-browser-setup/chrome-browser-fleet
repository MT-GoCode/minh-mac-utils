#!/usr/bin/env bash
# chrome-browser-fleet — isolated RemoteAgent Chrome instances for agents.
# Each "window" is its own Chrome on its own CDP port, cloned from your shared
# "RemoteAgent" profile, so every window starts with the same logins but no two
# agents share a browser. Verb required (no naked launch).
#
# Verbs:
#   chrome-browser-fleet new-window  "NAME" [--headless]   # launch; prints PORT
#   chrome-browser-fleet kill-window "NAME"                # tear that instance down
#   chrome-browser-fleet state                             # table: name | port | mode | tabs
#
# Then drive a window with agent-browser on its port, e.g.:
#   agent-browser --cdp <PORT> snapshot -i
#   agent-browser --cdp <PORT> screenshot out.png

set -euo pipefail

CHROME="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
CHROME_HOME="$HOME/Library/Application Support/Google/Chrome"
SEED="$HOME/.chrome-remoteagent"           # canonical seed (copied once from the RemoteAgent profile)
FLEET="$HOME/.chrome-remoteagent-fleet"    # per-instance clones + <port>.meta
PORT_LO=9222

[ -x "$CHROME" ] || { echo "error: Google Chrome not found at $CHROME" >&2; exit 1; }
mkdir -p "$FLEET"

cdp_up()        { curl -sf "http://127.0.0.1:$1/json/version" >/dev/null 2>&1; }
meta_name()     { sed -n 's/^name=//p' "$1" 2>/dev/null; }
meta_headless() { sed -n 's/^headless=//p' "$1" 2>/dev/null; }

seed_once() {
  [ -d "$SEED/Default" ] && return 0
  local src
  src="$(python3 - "$CHROME_HOME/Local State" <<'PY'
import json,sys
try: cache=json.load(open(sys.argv[1]))["profile"]["info_cache"]
except Exception: cache={}
for d,i in cache.items():
    if i.get("name")=="RemoteAgent": print(d); break
PY
)"
  [ -n "$src" ] || { echo "error: no Chrome profile named 'RemoteAgent' found — create it first" >&2; exit 1; }
  echo "seeding $SEED once from '$src' (RemoteAgent), excluding caches..." >&2
  mkdir -p "$SEED/Default"
  rsync -a --exclude 'Cache/' --exclude 'Code Cache/' --exclude 'GPUCache/' \
    --exclude 'GrShaderCache/' --exclude 'ShaderCache/' \
    --exclude 'Service Worker/CacheStorage/' --exclude 'component_crx_cache/' \
    "$CHROME_HOME/$src/" "$SEED/Default/"
}

find_port_by_name() {   # prints the port whose meta has name==$1
  local want="$1" f
  for f in "$FLEET"/*.meta; do
    [ -e "$f" ] || continue
    [ "$(meta_name "$f")" = "$want" ] && { basename "$f" .meta; return 0; }
  done
  return 1
}

free_port() {
  local p="$PORT_LO"
  while :; do
    if [ ! -e "$FLEET/$p.meta" ] && ! cdp_up "$p"; then echo "$p"; return; fi
    p=$((p+1))
  done
}

kill_port() {   # SIGTERM the instance on port $1, then wait for the process to actually exit
  pkill -TERM -f "remote-debugging-port=$1 " 2>/dev/null || true
  python3 - "$1" <<'PY'
import time,subprocess,sys
port=sys.argv[1]
for _ in range(40):
    if subprocess.run(["pgrep","-f",f"remote-debugging-port={port} "],capture_output=True).returncode!=0:
        break
    time.sleep(0.2)
PY
}

verb="${1:-}"; shift 2>/dev/null || true
case "$verb" in

  new-window)
    NAME=""; HEADLESS=0
    while [ $# -gt 0 ]; do
      case "$1" in
        --headless) HEADLESS=1 ;;
        --*) echo "error: unknown option $1" >&2; exit 2 ;;
        *)  NAME="$1" ;;
      esac; shift
    done
    [ -n "$NAME" ] || { echo "error: new-window needs a NAME" >&2; exit 2; }
    if p="$(find_port_by_name "$NAME")" && cdp_up "$p"; then
      echo "error: window \"$NAME\" is already running on port $p" >&2; exit 1
    fi
    seed_once
    PORT="$(free_port)"
    { echo "name=$NAME"; echo "headless=$HEADLESS"; } > "$FLEET/$PORT.meta"   # reserve the port
    PROF="$FLEET/$PORT.profile"
    rm -rf "$PROF"; mkdir -p "$PROF"
    cp -cR "$SEED/Default" "$PROF/Default" 2>/dev/null || cp -R "$SEED/Default" "$PROF/Default"  # APFS clone, else copy
    rm -f "$PROF"/Singleton* 2>/dev/null || true
    URL="data:text/html;charset=utf-8,<title>${NAME}</title><body style='font:16px -apple-system;padding:3rem'><h1>${NAME}</h1><p>Isolated RemoteAgent window. CDP :${PORT}.</p>"
    args=( --user-data-dir="$PROF" --remote-debugging-port="$PORT" --no-first-run --no-default-browser-check )
    [ "$HEADLESS" = 1 ] && args+=( --headless=new )
    args+=( "$URL" )
    "$CHROME" "${args[@]}" >/dev/null 2>&1 &
    if curl --retry 40 --retry-delay 1 --retry-connrefused -sf "http://127.0.0.1:$PORT/json/version" >/dev/null 2>&1; then
      echo "ok name=\"$NAME\" port=$PORT cdp=http://127.0.0.1:$PORT mode=$([ "$HEADLESS" = 1 ] && echo headless || echo headful)"
    else
      kill_port "$PORT"
      rm -f "$FLEET/$PORT.meta"; rm -rf "$PROF"
      echo "error: window \"$NAME\" failed to start (no CDP on port $PORT)" >&2; exit 1
    fi
    ;;

  kill-window)
    NAME="${1:-}"; [ -n "$NAME" ] || { echo "error: kill-window needs a NAME" >&2; exit 2; }
    if ! PORT="$(find_port_by_name "$NAME")"; then
      echo "error: no window named \"$NAME\"" >&2; exit 1
    fi
    kill_port "$PORT"                                                  # graceful, then wait for exit
    rm -f "$FLEET/$PORT.meta"; rm -rf "$FLEET/$PORT.profile"
    echo "killed \"$NAME\" (port $PORT)"
    ;;

  state)
    printf '%-24s %-6s %-9s %-5s %s\n' NAME PORT MODE TABS STATUS
    any=0
    for f in "$FLEET"/*.meta; do
      [ -e "$f" ] || continue
      any=1
      port="$(basename "$f" .meta)"
      name="$(meta_name "$f")"
      mode="$([ "$(meta_headless "$f")" = 1 ] && echo headless || echo headful)"
      if cdp_up "$port"; then
        tabs="$(curl -s "http://127.0.0.1:$port/json" | python3 -c "import json,sys;print(sum(1 for t in json.load(sys.stdin) if t.get('type')=='page'))" 2>/dev/null || echo '?')"
        status=up
      else
        tabs=0; status=dead
      fi
      printf '%-24s %-6s %-9s %-5s %s\n' "$name" "$port" "$mode" "$tabs" "$status"
    done
    [ "$any" = 1 ] || echo "(no windows)"
    ;;

  -h|--help|help)
    awk 'NR>1{ if(/^#/){sub(/^# ?/,"");print} else exit }' "$0" ;;

  "")
    echo "error: a verb is required — new-window | kill-window | state (see --help)" >&2; exit 2 ;;

  *)
    echo "error: unknown verb \"$verb\" — use new-window | kill-window | state" >&2; exit 2 ;;
esac
