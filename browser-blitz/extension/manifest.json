{
  "manifest_version": 3,
  "name": "browser-blitz-bridge",
  "version": "0.9.0",
  "description": "Bridges CDP from a local shim into this profile's tabs via chrome.debugger.",
  "permissions": [
    "debugger",
    "tabs",
    "tabGroups",
    "identity",
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "sw.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "128": "icons/icon128.png"
    }
  }
}