{
  "manifest_version": 3,
  "name": "browser-blitz-bridge",
  "version": "1.2.0",
  "description": "Tab groups, windows and a CDP relay for browser-blitz. Playwright does the driving.",
  "key": "",
  "permissions": [
    "debugger",
    "tabs",
    "tabGroups",
    "alarms",
    "storage"
  ],
  "background": {
    "service_worker": "sw.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "128": "icons/icon128.png"
    }
  }
}
