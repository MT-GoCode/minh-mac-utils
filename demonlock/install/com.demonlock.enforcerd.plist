<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.demonlock.enforcerd</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Applications/Demonlock.app/Contents/MacOS/demonlock</string>
        <string>enforcerd</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>2</integer>
    <key>StandardOutPath</key>
    <string>/Library/Application Support/Demonlock/logs/enforcerd.log</string>
    <key>StandardErrorPath</key>
    <string>/Library/Application Support/Demonlock/logs/enforcerd.log</string>
</dict>
</plist>
