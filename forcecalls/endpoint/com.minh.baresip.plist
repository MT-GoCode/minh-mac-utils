<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.minh.baresip</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/baresip</string>
    <string>-f</string><string>/etc/baresip</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>1</integer>
  <key>StandardOutPath</key><string>/var/log/baresip.log</string>
  <key>StandardErrorPath</key><string>/var/log/baresip.log</string>
</dict></plist>
