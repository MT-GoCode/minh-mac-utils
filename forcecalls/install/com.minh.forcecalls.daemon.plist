<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.minh.forcecalls.daemon</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/libexec/forcecalls</string>
        <string>daemon</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>5</integer>
    <key>StandardOutPath</key>
    <string>/Library/Application Support/Forcecalls/logs/daemon.log</string>
    <key>StandardErrorPath</key>
    <string>/Library/Application Support/Forcecalls/logs/daemon.log</string>
</dict>
</plist>
