#!/usr/bin/env bash
# gitas — one git identity manager for every machine (macOS + Linux).
#
# All GitHub auth goes over HTTPS with a PAT. git never stores a token: gitas IS the credential
# helper, and reads ~/.config/gitas/accounts.ini (0600, never committed) on each request.
# Identity (name/email) is routed by remote URL via includeIf; auth is routed by URL path via
# credential.useHttpPath. Same trigger, so the two can never drift apart.
set -euo pipefail

CONF="${GITAS_CONF:-$HOME/.config/gitas/accounts.ini}"
GITDIR="${GITAS_GITDIR:-$HOME/.config/git}"
INC="$GITDIR/gitas.inc"
INCD="$GITDIR/gitas.d"
SELF="$(command -v gitas 2>/dev/null || echo "$HOME/.local/bin/gitas")"

die()  { printf '✗ %s\n' "$*" >&2; exit 1; }
ok()   { printf '  ✓ %s\n' "$*"; }
warn() { printf '  ! %s\n' "$*" >&2; }

# ---------------------------------------------------------------- ini parsing
# Emits "slug|key|value" per entry. Section order preserved; first section is the default account.
parse_ini() {
  [ -f "$CONF" ] || die "no config at $CONF  (run: gitas init)"
  awk -F= '
    /^[[:space:]]*[#;]/ { next }
    /^[[:space:]]*\[/   { gsub(/^[[:space:]]*\[|\][[:space:]]*$/,""); slug=$0; print slug "|__section__|"; next }
    NF<2 || slug=="" { next }
    {
      k=$1; sub(/^[[:space:]]+|[[:space:]]+$/,"",k)
      v=substr($0, index($0,"=")+1); sub(/^[[:space:]]+|[[:space:]]+$/,"",v)
      if (k!="" && v!="") print slug "|" k "|" v
    }
  ' "$CONF"
}
slugs()      { parse_ini | awk -F'|' '$2=="__section__"{print $1}'; }
default_slug() { slugs | head -1; }
field()      { parse_ini | awk -F'|' -v s="$1" -v k="$2" '$1==s && $2==k {print $3; exit}'; }

need_field() { local v; v="$(field "$1" "$2")"; [ -n "$v" ] || die "account [$1] is missing '$2' in $CONF"; echo "$v"; }

# ---------------------------------------------------------------- matching
# A match entry looks like  github.com/datologyai/*  (comma separated). Compared against host/path.
match_slug() {  # <host/path>  -> slug (default if nothing matches)
  local target="$1" s pats p
  target="${target%.git}"
  for s in $(slugs); do
    pats="$(field "$s" match)" || true
    [ -n "${pats:-}" ] || continue
    IFS=',' read -r -a arr <<< "$pats"
    for p in "${arr[@]}"; do
      p="$(printf '%s' "$p" | tr -d '[:space:]')"; [ -n "$p" ] || continue
      # shellcheck disable=SC2254
      case "$target" in $p) echo "$s"; return 0;; esac
    done
  done
  default_slug
}

# ---------------------------------------------------------------- generate git config
cmd_install() {
  [ -f "$CONF" ] || die "no config at $CONF  (run: gitas init, then fill it in)"
  local d; d="$(default_slug)"; [ -n "$d" ] || die "$CONF declares no accounts"
  mkdir -p "$GITDIR" "$INCD"; rm -rf "$INCD"; mkdir -p "$INCD"

  {
    echo "# GENERATED BY gitas — do not edit. Edit $CONF then re-run: gitas install"
    echo "[user]"
    echo "	name = $(need_field "$d" name)"
    echo "	email = $(need_field "$d" email)"
    echo "[credential]"
    echo "	useHttpPath = true"
    echo '[credential "https://github.com"]'
    echo "	helper = "                      # reset: drop osxkeychain/gh/anything inherited
    echo "	helper = $SELF credential"
  } > "$INC"

  local s org pats p
  for s in $(slugs); do
    [ "$s" = "$d" ] && continue
    printf '[user]\n\temail = %s\n\tname = %s\n' "$(need_field "$s" email)" "$(need_field "$s" name)" > "$INCD/$s.inc"
    pats="$(field "$s" match)" || true
    [ -n "${pats:-}" ] || { warn "[$s] has no 'match' — reachable only via 'gitas use $s'"; continue; }
    IFS=',' read -r -a arr <<< "$pats"
    for p in "${arr[@]}"; do
      p="$(printf '%s' "$p" | tr -d '[:space:]')"; [ -n "$p" ] || continue
      org="${p#*/}"; org="${org%%/*}"; [ -n "$org" ] || continue
      # Two patterns: '**' only spans separators as its own component, so slash-form URLs
      # (https://, ssh://) and colon-form (git@host:org/repo) need different globs.
      {
        printf '[includeIf "hasconfig:remote.*.url:**/%s/**"]\n\tpath = %s\n' "$org" "$INCD/$s.inc"
        printf '[includeIf "hasconfig:remote.*.url:*:%s/**"]\n\tpath = %s\n'  "$org" "$INCD/$s.inc"
      } >> "$INC"
    done
  done

  # ~/.gitconfig keeps only the include line; your own aliases there survive regeneration.
  touch "$HOME/.gitconfig"
  if ! git config --global --get-all include.path 2>/dev/null | grep -qx "$INC"; then
    git config --global --add include.path "$INC"
  fi
  ok "generated $INC"
  ok "default account: $d"
}

# ---------------------------------------------------------------- credential helper
cmd_credential() {
  local op="${1:-get}"; [ "$op" = get ] || exit 0    # store/erase: nothing to persist
  local host="" path="" line key val
  while IFS= read -r line; do
    [ -z "$line" ] && break
    key="${line%%=*}"; val="${line#*=}"
    case "$key" in host) host="$val";; path) path="$val";; esac
  done
  [ -n "$host" ] || exit 0
  local s; s="$(match_slug "$host/$path")"
  local u t; u="$(field "$s" user)"; t="$(field "$s" token)"
  [ -n "$u" ] && [ -n "$t" ] || { warn "account [$s] has no user/token — add them to $CONF"; exit 0; }
  printf 'username=%s\npassword=%s\n' "$u" "$t"
}

# ---------------------------------------------------------------- misc commands
cmd_give_pat() { local s="${1:?usage: gitas give-pat <slug>}"; need_field "$s" token; }

cmd_exec() {  # gitas exec <slug> -- cmd...
  local s="${1:?usage: gitas exec <slug> -- <cmd>}"; shift
  [ "${1:-}" = "--" ] && shift
  [ $# -gt 0 ] || die "usage: gitas exec <slug> -- <cmd>"
  GH_TOKEN="$(need_field "$s" token)" \
  GIT_AUTHOR_NAME="$(need_field "$s" name)"   GIT_COMMITTER_NAME="$(need_field "$s" name)" \
  GIT_AUTHOR_EMAIL="$(need_field "$s" email)" GIT_COMMITTER_EMAIL="$(need_field "$s" email)" \
    exec "$@"
}

cmd_use() {   # prints shell exports; use as:  eval "$(gitas use work)"
  local s="${1:?usage: eval \"\$(gitas use <slug>)\"}"
  cat <<EOS
export GIT_AUTHOR_NAME='$(need_field "$s" name)' GIT_COMMITTER_NAME='$(need_field "$s" name)'
export GIT_AUTHOR_EMAIL='$(need_field "$s" email)' GIT_COMMITTER_EMAIL='$(need_field "$s" email)'
export GH_TOKEN='$(need_field "$s" token)'
export GITAS_FORCE='$s'
export GIT_CONFIG_COUNT=2 GIT_CONFIG_KEY_0=credential.helper GIT_CONFIG_VALUE_0= GIT_CONFIG_KEY_1=credential.helper GIT_CONFIG_VALUE_1='$SELF credential-forced'
EOS
}
cmd_off() {
  cat <<'EOS'
unset GIT_AUTHOR_NAME GIT_COMMITTER_NAME GIT_AUTHOR_EMAIL GIT_COMMITTER_EMAIL GH_TOKEN GITAS_FORCE
unset GIT_CONFIG_COUNT GIT_CONFIG_KEY_0 GIT_CONFIG_VALUE_0 GIT_CONFIG_KEY_1 GIT_CONFIG_VALUE_1
EOS
}
cmd_credential_forced() {
  local op="${1:-get}"; [ "$op" = get ] || exit 0
  local s="${GITAS_FORCE:?GITAS_FORCE unset}"
  while IFS= read -r line; do [ -z "$line" ] && break; done
  printf 'username=%s\npassword=%s\n' "$(need_field "$s" user)" "$(need_field "$s" token)"
}

cmd_list() {
  local d; d="$(default_slug)"
  printf '%-12s %-28s %-22s %s\n' SLUG EMAIL USER MATCH
  local s; for s in $(slugs); do
    printf '%-12s %-28s %-22s %s%s\n' "$s" "$(field "$s" email)" "$(field "$s" user)" \
      "$(field "$s" match)" "$([ "$s" = "$d" ] && echo '   (default)')"
  done
}

cmd_status() {
  local url; url="$(git config --get remote.origin.url 2>/dev/null || true)"
  if [ -z "$url" ] && [ -z "${GITAS_FORCE:-}" ]; then echo "not in a git repo with an origin"; return 0; fi
  [ -n "$url" ] && echo "remote : $url"
  # A shell override wins over URL routing, so report it as the effective account.
  if [ -n "${GITAS_FORCE:-}" ]; then
    echo "account: $GITAS_FORCE   (forced for this shell — 'eval \"\$(gitas off)\"' to clear)"
  else
    local hp="${url#*://}"; hp="${hp#*@}"; hp="${hp/://}"
    echo "account: $(match_slug "$hp")"
  fi
  echo "email  : $(git config user.email 2>/dev/null || echo '(unset)')"
  git config --show-origin user.email 2>/dev/null | sed 's/^/from   : /'
}

cmd_init() {
  mkdir -p "$(dirname "$CONF")"
  [ -f "$CONF" ] && die "$CONF already exists"
  cat > "$CONF" <<'EOS'
# gitas accounts. First section is the DEFAULT (used when nothing matches).
# 0600, machine-local — never commit this file.
[personal]
name  = Your Name
email = you@example.com
user  = your-github-username
token = ghp_replace_me
match = github.com/your-github-username/*

# [work]
# name  = Your Name
# email = you@company.com
# user  = your-work-github-username
# token = github_pat_replace_me
# match = github.com/your-work-org/*
EOS
  chmod 600 "$CONF"
  ok "scaffolded $CONF — fill it in, then: gitas install"
}

cmd_purge() {
  echo "▸ removing every git identity/credential store outside gitas"
  local k
  for k in user.name user.email credential.helper credential.useHttpPath; do
    git config --global --unset-all "$k" 2>/dev/null || true
  done
  # Subsections take dotted form here — the bracketed '[credential "url"]' spelling is a silent no-op.
  local sec
  for sec in $(git config --global --name-only --get-regexp '^credential\.' 2>/dev/null \
               | sed -n 's/^\(credential\..*\)\.[^.]*$/\1/p' | sort -u); do
    git config --global --remove-section "$sec" 2>/dev/null || true
  done
  ok "cleared global git user + credential config"
  if [ -d "$HOME/.config/gh" ]; then
    rm -rf "$HOME/.config/gh"; ok "removed ~/.config/gh (gh binary kept; drive it with: gitas exec <slug> -- gh ...)"
  else
    ok "no stored gh auth to remove"
  fi
  if command -v security >/dev/null 2>&1; then
    n=0; while security delete-internet-password -s github.com >/dev/null 2>&1; do n=$((n+1)); done
    [ "$n" -gt 0 ] && ok "cleared $n github.com entry(ies) from the macOS keychain" \
                   || ok "no github.com keychain entries to clear"
  fi
  local sc="$HOME/.ssh/config"
  if [ -f "$sc" ]; then
    local before after
    before=$(grep -c "^[[:space:]]*Host[[:space:]]" "$sc" 2>/dev/null || echo 0)
    awk '
      /^[[:space:]]*Host[[:space:]]/ { drop = ($0 ~ /(^|[[:space:]])(github\.com|github-pers|github-imbue)([[:space:]]|$)/) }
      !drop
    ' "$sc" > "$sc.gitas.tmp" && mv "$sc.gitas.tmp" "$sc"
    after=$(grep -c "^[[:space:]]*Host[[:space:]]" "$sc" 2>/dev/null || echo 0)
    if [ "$before" -gt "$after" ]; then
      ok "removed $((before-after)) GitHub Host block(s) from ~/.ssh/config (all other hosts and every key left untouched)"
    else
      ok "no GitHub Host blocks in ~/.ssh/config"
    fi
  fi
}

case "${1:-}" in
  install)            shift; cmd_install "$@" ;;
  init)               shift; cmd_init "$@" ;;
  credential)         shift; cmd_credential "$@" ;;
  credential-forced)  shift; cmd_credential_forced "$@" ;;
  give-pat)           shift; cmd_give_pat "$@" ;;
  exec)               shift; cmd_exec "$@" ;;
  use)                shift; cmd_use "$@" ;;
  off)                shift; cmd_off "$@" ;;
  list)               shift; cmd_list "$@" ;;
  status)             shift; cmd_status "$@" ;;
  purge)              shift; cmd_purge "$@" ;;
  ""|-h|--help|help)
    cat <<'EOS'
gitas — one git identity manager, every machine.

  gitas init                 scaffold ~/.config/gitas/accounts.ini (0600)
  gitas install              (re)generate git config from accounts.ini — idempotent
  gitas list                 show accounts (first = default)
  gitas status               which account applies in this repo, and why
  gitas give-pat <slug>      print that account's PAT to stdout
  gitas exec <slug> -- CMD   run CMD with GH_TOKEN + author identity set (e.g. gh release create)
  eval "$(gitas use <slug>)" force an account for THIS shell only
  eval "$(gitas off)"        drop the override
  gitas purge                remove all git identity state outside gitas
EOS
    ;;
  *) die "unknown command: $1  (gitas help)" ;;
esac
