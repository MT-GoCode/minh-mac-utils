#!/usr/bin/env python3
"""irreproachable — keep a Paseo agent working toward a goal until it says the goal is met.

    irreproachable new "<goal>" [--steer-every 30m] [--idle-after 6m] [--steer-prompt TEXT] [--agent ID]
    irreproachable clear [--agent ID]
    irreproachable mute [DURATION] [--agent ID]
    irreproachable unmute [--agent ID]
    irreproachable ls
    irreproachable --selftest

Run `new` inside a Paseo agent and it governs that agent ($PASEO_AGENT_ID). A detached watcher
re-sends the goal whenever nothing has woken the agent for --idle-after, and every --steer-every
sends a steer -- a progress-and-discipline check -- interrupting the agent if it is busy, because
Paseo has no queue. The agent runs `irreproachable clear` when the goal is met.

It checks the agent with `paseo inspect` (1.45 s CPU each, measured) rather than holding
`paseo wait`, because a blocked `paseo wait` holds 150 MB (measured) and this runs on a 4 GB box.
Between checks it sleeps until the earliest moment a send could become due, so an idle or busy
agent costs one check per --idle-after, not one every few seconds. The watcher is double-forked and reparented to init
because the agent harness kills process trees when a tool call ends.

State lives in ~/.irreproachable/<agent-id>/. `meta.json` is written once, by the watcher.
`log` holds `<epoch> <event>` lines; an `END <reason>` line records how a goal ended.
"""
import argparse, datetime, filecmp, json, os, re, select, shutil, signal, subprocess, sys, tempfile, time, uuid

HOME          = os.path.expanduser("~/.irreproachable")
IDLE_AFTER    = 360   # pacemaker EVERY_MAX 300s (Minh's) + 60s for ping delivery
START_TIMEOUT = 5     # ~300x the measured 16 ms watcher startup
SLACK         = 5     # inspect + send wall time, 1.1 s each measured, x2 headroom
STEER_EVERY   = 1800  # Minh's number
MUTE_MAX      = 3600  # Minh's number: a mute is at most 1h, and that is also the default
BUSY          = ("running", "initializing")   # Paseo BUSY_STATUSES (agent-manager.js:173)
C_LOCALE      = {**os.environ, "LC_ALL": "C"}

GOAL_PROMPT = """[Automated Goal Reminder -- do not ignore]
Nothing has woken you for {quiet}. Keep working toward the goal below.
If you are waiting on something, do truly orthogonal work on the side while you wait -- work that cannot
conflict with what you are waiting on. When the goal is met irreproachably, run `irreproachable clear`
and say so. Do not clear it to escape the work.

[Goal]
{goal}"""

STEER_HEADER = "[Automated Steer -- do not ignore]"
STEER_BODY = """Give a concise, high-signal progress report to the user of your progress relative to the final goal.
1. If you are going down a rabbit hole, only continue if it is genuinely in the way of the goal. Can this
   be abandoned and just accepted as debt later on? Should you research better solutions either online
   or other code?
2. If any judgement calls need to be made, can it be done by prioritizing progress toward the goal and
   exemplifying the code principles?
3. Are you exemplifying any reminders stated in the goal prompt? Are you making a concentrated effort to
   deliver and exemplify code principles?

Remember, all that matters to the user is the accomplishment of the goal in an irreproachable manner,
exemplifying code-principles, and simplicity, whether it takes subagents, code-review, probes,
decisions made, etc."""
# A steer interrupts a busy agent (Paseo has no queue); this line makes it carry on afterwards (measured).
RESUME = ("If this message cut off a tool call, that was deliberate and is not a rejection or an error. Report, "
          "then immediately redo the interrupted step and carry on in this same turn. Do not stop to ask.")


def steer_text(cfg):
    return (f"{STEER_HEADER}\n{cfg['steer_prompt'] or STEER_BODY}\n\n{RESUME}\n\n"
            f"[Goal Prompt Reminder]\n{cfg['goal']}")


def dur(s):
    m = re.fullmatch(r"([1-9]\d*)([smh])", s)
    if not m:
        raise argparse.ArgumentTypeError("a duration like 30s, 6m or 2h")
    return int(m[1]) * {"s": 1, "m": 60, "h": 3600}[m[2]]


def fmt(sec):
    sec = int(sec)
    h, m, s = sec // 3600, (sec % 3600) // 60, sec % 60
    return f"{h}h{m:02d}m{s:02d}s" if h else (f"{m}m{s:02d}s" if m else f"{s}s")


class PaseoError(Exception):
    @property
    def not_found(self):
        return "Agent not found" in str(self)


def paseo(*args):
    try:
        p = subprocess.run(["paseo", *args, "--json"], capture_output=True, text=True)
    except FileNotFoundError:
        raise PaseoError("paseo not on PATH -- run irreproachable/install.sh, which installs a shim if needed")
    if p.returncode == 0:
        return json.loads(p.stdout)
    raw = (p.stdout + p.stderr).strip()    # paseo puts its error JSON on stderr
    try:
        msg = json.loads(raw)["error"]["message"]
    except (ValueError, KeyError, TypeError):
        msg = raw
    raise PaseoError(msg)


def gdir(aid):      return os.path.join(HOME, aid)
def meta_path(aid): return os.path.join(gdir(aid), "meta.json")
def log_path(aid):  return os.path.join(gdir(aid), "log")
def muted_path(aid): return os.path.join(gdir(aid), "muted")


def muted_until(aid, token):
    """End of this goal's mute, or 0. The file names its goal's token, so a mute never outlives its goal."""
    try:
        with open(muted_path(aid)) as f:
            tok, until = f.read().split()
    except FileNotFoundError:
        return 0.0
    return float(until) if tok == token else 0.0


def read_meta(aid):
    try:
        with open(meta_path(aid)) as f:
            return json.load(f)
    except FileNotFoundError:
        return None


def write_meta(aid, m):
    os.makedirs(gdir(aid), exist_ok=True)
    tmp = f"{meta_path(aid)}.tmp.{os.getpid()}"
    with open(tmp, "w") as f:
        json.dump(m, f)
    os.replace(tmp, meta_path(aid))


def log(aid, event):
    event = " ".join(event.split())        # a multi-line paseo error must not break the log format
    with open(log_path(aid), "a") as f:
        f.write(f"{time.time():.3f} {event}\n")


def log_lines(aid):
    try:
        with open(log_path(aid)) as f:
            return [(float(t), e) for t, e in (l.rstrip("\n").split(" ", 1) for l in f if l.strip())]
    except FileNotFoundError:
        return []


def lstart(pid):
    p = subprocess.run(["ps", "-o", "lstart=", "-p", str(pid)], capture_output=True, text=True, env=C_LOCALE)
    out = p.stdout.strip()
    return out if p.returncode == 0 and out else None


def ended(aid, token):
    """Why the goal with this token ended, or None. The log outlives goals, so lines carry the token."""
    for _, e in reversed(log_lines(aid)):
        if e.startswith(f"END {token} "):
            return e.split(" ", 2)[2]
    return None


def alive(aid, m=None):
    m = m or read_meta(aid)
    return m is not None and ended(aid, m["token"]) is None and lstart(m["pid"]) == m["lstart"]


def die(code, msg):
    print(f"irreproachable: {msg}", file=sys.stderr)
    sys.exit(code)


def resolve_agent(arg):
    aid = arg or os.environ.get("PASEO_AGENT_ID", "").strip()
    if not aid:
        die(2, "no agent — pass --agent ID or run inside a Paseo agent")
    return aid


def goals():
    """Ids of goal dirs that still have meta: live, or ended but not yet cleared."""
    return [n for n in (os.listdir(HOME) if os.path.isdir(HOME) else []) if os.path.exists(meta_path(n))]


def find_goal(aid):
    """The goal for an id or id prefix, or None. Works after the agent itself is gone."""
    hits = [n for n in goals() if n.startswith(aid)]
    if len(hits) > 1:
        die(2, f"{aid} is ambiguous")
    return hits[0] if hits else None


def state(aid, m):
    if not alive(aid, m):
        return f"ENDED {ended(aid, m['token']) or 'watcher died'}"
    left = muted_until(aid, m["token"]) - time.time()
    return f"watching (muted {fmt(left)})" if left > 0 else "watching"


def live_goal(arg):
    """The live goal for an id or prefix, or exit 1 saying there is none."""
    want = resolve_agent(arg)
    aid = find_goal(want)
    m = read_meta(aid) if aid else None
    if not (m and alive(aid, m)):
        die(1, f"no live goal on {want[:8]}")
    return aid, m


def poke(m):                                    # wake the watcher so a mute change takes effect at once
    try:
        os.kill(m["pid"], signal.SIGUSR1)
    except (ProcessLookupError, PermissionError):
        pass                                    # gone since alive() looked, or the pid now belongs to someone else


def cmd_mute(a):
    if a.duration > MUTE_MAX:
        die(2, f"a mute is at most {fmt(MUTE_MAX)}")
    aid, m = live_goal(a.agent)
    tmp = f"{muted_path(aid)}.tmp.{os.getpid()}"
    with open(tmp, "w") as f:
        f.write(f"{m['token']} {time.time() + a.duration}")
    os.replace(tmp, muted_path(aid))
    log(aid, f"MUTED {m['token']} for={a.duration}")
    poke(m)
    print(f"goal prompts muted on {aid[:8]} for {fmt(a.duration)} (steers continue)")


def cmd_unmute(a):
    aid, m = live_goal(a.agent)
    try:
        if muted_until(aid, m["token"]) <= time.time():
            raise FileNotFoundError             # expired, or left by an earlier goal
        os.remove(muted_path(aid))
    except FileNotFoundError:
        print(f"{aid[:8]} was not muted")
        return
    log(aid, f"UNMUTED {m['token']}")
    poke(m)
    print(f"goal prompts unmuted on {aid[:8]}")


def updated_at(info):
    return datetime.datetime.fromisoformat(info["UpdatedAt"].replace("Z", "+00:00")).timestamp()


# ---------------------------------------------------------------------------------------------- watcher

WATCH_ARG, WATCH_ENV = "_watch", "IRREPROACHABLE_WATCH"


def spawn(cfg):
    """Double fork: the middle process exits so the watcher is reparented to init before the tool
    call that launched it ends. setsid makes the watcher's pid its process group, so `clear`'s
    killpg also takes down a `paseo send` that is in flight. The watcher then re-execs as
    `irreproachable _watch`, so its command line never carries the goal: an agent running
    `pkill -f <a word from its goal>` must not kill its own watcher."""
    me = os.path.abspath(sys.argv[0])
    mid = os.fork()
    if mid:
        os.waitpid(mid, 0)
        return
    try:
        if os.fork() == 0:
            try:
                os.setsid()
                os.chdir("/")                     # do not pin the invoking agent's directory
                fd = os.open(os.devnull, os.O_RDWR)
                for n in (0, 1, 2):
                    os.dup2(fd, n)
                os.execve(sys.executable, [sys.executable, me, WATCH_ARG], {**os.environ, WATCH_ENV: json.dumps(cfg)})
            except BaseException as e:
                try:
                    log(cfg["aid"], f"END {cfg['token']} crashed: {type(e).__name__}: {e}")
                except BaseException:
                    pass    # the goal directory may already be gone; there is nobody left to tell
            finally:
                os._exit(0)
    finally:
        os._exit(0)


def watch(cfg):
    me, aid, tok = os.getpid(), cfg["aid"], cfg["token"]
    # mute/unmute poke us with SIGUSR1 once meta exists, so the handler goes in first. The self-pipe turns the
    # signal into readable bytes: the sleep below ends early, and a poke during a paseo call is not lost.
    wake_r, wake_w = os.pipe()
    os.set_blocking(wake_w, False)
    signal.signal(signal.SIGUSR1, lambda *_: None)
    signal.set_wakeup_fd(wake_w)
    started = lstart(me)
    assert started, "ps -o lstart= failed"     # a null lstart would make a dead watcher look alive
    write_meta(aid, {"pid": me, "lstart": started, "token": tok, "goal": cfg["goal"],
                     "idle_after": cfg["idle_after"], "steer_every": cfg["steer_every"],
                     "steer_prompt": cfg["steer_prompt"], "started": time.time()})
    log(aid, f"START {tok}")
    last_sent, next_steer = 0.0, time.time() + cfg["steer_every"]

    def mine():
        m = read_meta(aid)
        return m is not None and m["pid"] == me

    def finish(e):
        log(aid, f"END {tok} " + ("agent gone" if e.not_found else f"paseo: {e}"))

    def send(kind, text, quiet):
        nonlocal last_sent
        if not mine():
            return False
        last_sent = time.time()
        log(aid, f"SEND {tok} {kind} quiet={int(quiet)}")   # logged before the call: an END after it = not delivered
        try:
            paseo("send", "--no-wait", aid, "--prompt", text)
        except PaseoError as e:
            finish(e)
            return False
        return True

    while mine():
        try:
            info = paseo("inspect", aid)
        except PaseoError as e:
            return finish(e)
        if info.get("Archived"):
            return log(aid, f"END {tok} agent gone")
        now = time.time()
        pending = bool(info.get("PendingPermissions"))
        idle = not pending and info["Status"] not in BUSY
        if pending:
            next_steer = max(next_steer, now + cfg["steer_every"])   # time waiting on Minh doesn't count
        quiet = now - max(updated_at(info), last_sent)
        # A busy (or permission-blocked) agent has not ended its turn, so its quiet clock restarts no
        # earlier than now: the earliest a goal prompt can be due is a full idle_after from now.
        due = now - quiet + cfg["idle_after"] if idle else now + cfg["idle_after"]
        due = max(due, muted_until(aid, tok))      # a mute holds goal prompts only; steers keep their cadence
        goal_due = idle and now >= due
        # A steer due within idle_after goes out instead of the goal prompt (it carries the goal), so we
        # never interrupt a goal prompt we just sent.
        if now >= next_steer or (goal_due and next_steer - now < cfg["idle_after"]):
            if not send("steer", steer_text(cfg), quiet):
                return
            next_steer, due = time.time() + cfg["steer_every"], time.time() + cfg["idle_after"]
        elif goal_due:
            if not send("goal", GOAL_PROMPT.format(quiet=fmt(quiet), goal=cfg["goal"]), quiet):
                return
            due = time.time() + cfg["idle_after"]
        # Agent activity only moves `due` later; only a mute change moves it earlier, and its poke ends the wait.
        if select.select([wake_r], [], [], max(1, min(due, next_steer) - time.time()))[0]:
            os.read(wake_r, 512)                   # poked: re-read the mute and recompute


# --------------------------------------------------------------------------------------------- commands

def cmd_new(a):
    aid = resolve_agent(a.agent)
    try:
        info = paseo("inspect", aid)
    except PaseoError as e:
        die(2, str(e))
    if info.get("Archived"):
        die(2, f"agent {aid[:8]} is archived")
    aid = info["Id"]
    prior = read_meta(aid)
    replacing = prior is not None and alive(aid, prior)
    if replacing:
        log(aid, f"REPLACED {prior['token']}")
        try:
            os.killpg(prior["pid"], signal.SIGTERM)
        except ProcessLookupError:
            pass
    token = uuid.uuid4().hex
    spawn({"aid": aid, "token": token, "goal": a.goal, "idle_after": a.idle_after,
           "steer_every": a.steer_every, "steer_prompt": a.steer_prompt})
    deadline = time.time() + START_TIMEOUT
    while time.time() < deadline:
        m = read_meta(aid)
        if m and m["token"] == token:
            print(f"{'replaced goal on' if replacing else 'watching'} {aid[:8]} — goal prompt after "
                  f"{fmt(a.idle_after)} idle, steer every {fmt(a.steer_every)}")
            return
        time.sleep(0.05)
    die(1, f"watcher did not start (see {log_path(aid)})")


def cmd_clear(a):
    want = resolve_agent(a.agent)
    aid = find_goal(want)
    m = read_meta(aid) if aid else None
    if m is None:                               # already cleared: clearing twice is not an error
        print(f"no goal on {want[:8]}")
        return
    was = alive(aid, m)
    try:
        os.remove(meta_path(aid))
    except FileNotFoundError:                   # a concurrent clear won
        print(f"no goal on {want[:8]}")
        return
    try:
        os.remove(muted_path(aid))
    except FileNotFoundError:
        pass
    if was:
        log(aid, f"CLEARED {m['token']}")
        try:
            os.killpg(m["pid"], signal.SIGTERM)
        except ProcessLookupError:
            pass
    print(f"cleared goal on {aid[:8]}" if was else f"removed ended goal on {aid[:8]}")


def cmd_ls(a):
    try:
        titles = {x["id"]: x.get("name") or "-" for x in paseo("ls")}
    except PaseoError:
        titles = {}
        print("irreproachable: paseo unavailable — titles omitted", file=sys.stderr)
    now = time.time()
    rows = [(m, aid) for aid in goals() for m in [read_meta(aid)] if m]
    for m, aid in sorted(rows, key=lambda r: r[0]["started"]):
        print(f"{aid[:8]}  {state(aid, m):<26}  {fmt(now - m['started']):>8}  "
              f"{titles.get(aid, '-')[:30]:<30}  {m['goal'][:60]}")


# --------------------------------------------------------------------------------------------- selftest

SECTIONS = ("args", "goal", "steer-a", "steer-b", "steer-c", "edges", "mute")


def selftest(only):
    if os.getuid() == 0:
        die(1, "do not run as root — irreproachable is a per-user tool")
    os.environ.pop("PASEO_AGENT_ID", None)     # the suite runs inside Minh's agent; never govern it
    SELF = os.path.abspath(__file__)
    inst = shutil.which("irreproachable")
    if not (inst and filecmp.cmp(inst, SELF, shallow=False)):
        die(1, "run ./install.sh first — the agents under test call irreproachable from PATH")
    want = lambda name: not only or name in only
    results, CREATED, PIDS = [], [], []
    FIXTURES = [os.path.join(HOME, d) for d in ("zzirr-dead", "zzirr-live")]
    # One workspace for the whole run: outside an agent, `paseo run` would otherwise make one per agent and
    # leave it behind after the agent is deleted.
    WS = paseo("workspace", "create", "--isolation", "local", "--path", tempfile.gettempdir(),
               "--title", "irr-selftest")["workspaceId"]

    def check(name, ok, detail=""):
        results.append(ok)
        print(f"  {'✓' if ok else '✗'} {name}" + ("" if ok or not detail else f"\n      {detail}"), flush=True)

    def run(*args):
        return subprocess.run([SELF, *args], capture_output=True, text=True)

    def spawn_agent(title, prompt, mode="bypassPermissions"):
        aid = paseo("run", "--background", "--workspace", WS, "--title", f"irr-selftest-{title}",
                    "--provider", "claude/claude-haiku-4-5-20251001", "--mode", mode, prompt)["agentId"]
        CREATED.append(aid)
        return aid

    def drop(aid):              # one throwaway agent alive at a time: ox-dev has 4 GB
        subprocess.run(["paseo", "delete", aid], capture_output=True)

    def sent(aid, tok, kind):
        return [t for t, e in log_lines(aid) if e.startswith(f"SEND {tok} {kind} ")]

    def wstart(aid, tok):
        return next(t for t, e in log_lines(aid) if e == f"START {tok}")

    def timeline(aid):
        return subprocess.run(["paseo", "logs", aid], capture_output=True, text=True).stdout

    def line_after(tl, marker):
        tll = tl.splitlines()
        return [tll[i + 1] for i, l in enumerate(tll[:-1]) if l.strip() == marker]   # paseo logs cuts long lines

    def note(m_):               # every watcher the suite starts, so the final leftover check covers them all
        if m_:
            PIDS.append((m_["pid"], m_["lstart"]))
        return m_ or {}

    def meta_of(aid):           # the first meta seen; waits for the agent to have run `new`
        wait_for(lambda: read_meta(aid) is not None, 120, 2)
        return note(read_meta(aid))

    def wait_for(pred, timeout, step):
        end = time.time() + timeout
        while time.time() < end:
            if pred():
                return True
            time.sleep(step)
        return pred()

    def cleanup():
        for aid in CREATED:
            m = read_meta(aid)
            if m and alive(aid):
                try:
                    os.killpg(m["pid"], signal.SIGTERM)
                except ProcessLookupError:
                    pass
            subprocess.run(["paseo", "delete", aid], capture_output=True)
            shutil.rmtree(gdir(aid), ignore_errors=True)
        subprocess.run(["paseo", "workspace", "archive", WS], capture_output=True)
        for d in FIXTURES:
            shutil.rmtree(d, ignore_errors=True)

    try:
        if want("args"):
            print("### arguments", flush=True)
            r = run("new", "x")
            check("new with no agent exits 2", r.returncode == 2 and "no agent" in r.stderr, r.stderr)
            r = run("new", "x", "--agent", "00000000-dead-beef-0000-000000000000")
            check("new on a missing agent exits 2", r.returncode == 2 and "Agent not found" in r.stderr, r.stderr)
            for bad in ("0s", "5"):
                r = run("new", "x", "--idle-after", bad, "--agent", "x")
                check(f"--idle-after {bad} is refused", r.returncode == 2 and "duration" in r.stderr, r.stderr)

        if want("goal"):
            print("### goal loop", flush=True)
            tmp = tempfile.mkdtemp(prefix="irr-")
            n, marks, work = (os.path.join(tmp, f) for f in ("n.txt", "marks", "work.py"))
            IDLE = 45                   # longer than a Haiku turn: a send keyed to the wrong clock lands visibly early
            with open(n, "w") as f:     # line 1 is ours, so the agent's first turn is only `new` plus busy work
                f.write(f"1 {int(time.time())}\n")
            with open(work, "w") as f:  # 50 s of observable busyness, under the 60 s foreground rule
                f.write(f'import time\nf = open("{marks}", "a")\nf.write("START %d\\n" % time.time()); f.flush()\n'
                        f'time.sleep(50)\nf.write("END %d\\n" % time.time())\n')
            GOAL = (f"Make {n} have exactly 3 lines. It already has line 1. Each time you are prompted, append exactly ONE "
                    f"line to it: the next integer, a space, and the current Unix time in seconds (run date +%s). Never "
                    f"append more than one line in a turn. When the file has 3 lines, run: irreproachable clear")
            aid = spawn_agent("goal", f'This is an automated test of a tool; follow it literally. First run exactly this '
                                      f'with Bash: `irreproachable new "{GOAL}" --idle-after {IDLE}s` Then, as a deliberate '
                                      f'part of the test, run `python3 {work}` with Bash in the FOREGROUND '
                                      f'(run_in_background false, timeout 120000) -- do not background it. Do not touch '
                                      f'{n} in this turn. Then end your turn and wait to be prompted.')
            seen = {}

            def cleared():
                m = read_meta(aid)
                if m and "meta" not in seen:
                    seen["meta"] = note(m)
                return "meta" in seen and m is None
            # ~20s spawn + ~60s turn 1 + 2 x (45s idle + SLACK + ~20s turn) ~= 230s
            check("the agent cleared its goal", wait_for(cleared, 420, 5))
            meta = seen.get("meta", {})
            check("the watcher exits", bool(meta) and wait_for(lambda: lstart(meta["pid"]) != meta["lstart"], SLACK, 1))   # clear killpg's it
            lines = log_lines(aid)                       # read after the watcher is gone, so a late send would show
            events = [e for _, e in lines]
            check("the goal arrived unmangled", meta.get("goal") == GOAL, repr(meta.get("goal")))
            check("new ran exactly once", sum(e.startswith("START ") for e in events) == 1, events)
            tok = meta.get("token")
            try:
                rows = [l.split() for l in open(n).read().splitlines()]
                mk = [l.split() for l in open(marks).read().splitlines()]
            except FileNotFoundError:
                rows, mk = [], []
            ok_rows = len(rows) == 3 and [r[0] for r in rows] == ["1", "2", "3"] and all(len(r) == 2 for r in rows)
            check("n.txt has lines 1, 2, 3", ok_rows, rows)
            sends = [t for t, e in lines if e.startswith(f"SEND {tok} goal")]
            check("exactly two goal prompts", len(sends) == 2, sends)
            busy = [(int(a[1]), int(b[1])) for a, b in zip(mk, mk[1:]) if a[0] == "START" and b[0] == "END"]
            check("the busy work ran", len(busy) >= 1, mk)
            check("no prompt while the agent was busy",
                  bool(busy) and not any(a <= s < b + 1 for s in sends for a, b in busy), f"busy={busy} sends={sends}")
            if ok_rows and len(sends) == 2 and busy:
                t2, t3 = int(rows[1][1]), int(rows[2][1])
                causal = sends[0] < t2 + 1 and t2 <= sends[1] < t3 + 1
                # quiet counts from the end of the turn: after the busy work's END, then after the `date` of line 2
                gated = all(t + IDLE - 1 <= s <= t + IDLE + SLACK + 30 for t, s in ((busy[-1][1], sends[0]), (t2, sends[1])))
            else:
                causal = gated = False
            check("each line followed the goal prompt that caused it", causal, f"lines={rows} sends={sends}")
            check("each prompt came idle-after after the turn before it, not sooner", gated,
                  f"busy={busy} lines={rows} sends={sends}")
            cl = [t for t, e in lines if e == f"CLEARED {tok}"]
            check("no send after the clear", bool(cl) and all(t < cl[0] for t, e in lines if e.startswith("SEND")), lines)
            tl = timeline(aid)
            after = line_after(tl, "[Goal]")
            check("the prompts carried the header and the goal",
                  tl.count("[Automated Goal Reminder") == 2 and len(after) == 2
                  and all(x.startswith(GOAL[:60]) for x in after), tl[-1500:])
            shutil.rmtree(tmp, ignore_errors=True)
            drop(aid)

        if want("steer-a"):
            print("### steer interrupts a busy agent, which then resumes", flush=True)
            tmp = tempfile.mkdtemp(prefix="irr-")
            marks, done, work, dl = (os.path.join(tmp, f) for f in ("marks", "done", "work.py", "deadline"))
            # The work runs until a deadline the selftest sets once the goal is registered: watcher start + 130, so it
            # is ~38 s after the first steer (wstart+~92) and ~37 s before the second (~wstart+182) -- independent of
            # how long the agent took to spawn. A resumed run only waits out the remainder.
            with open(work, "w") as f:
                f.write(f'import os, time\nf = open("{marks}", "a")\nf.write("START %d\\n" % time.time()); f.flush()\n'
                        f'while not os.path.exists("{dl}") or time.time() < float(open("{dl}").read()):\n'
                        f'    time.sleep(1)\nf.write("END %d\\n" % time.time())\n')
            GOAL = f"After the work command finishes, append the word DONE to {done}. Then run: irreproachable clear"
            aid = spawn_agent("steer-a", f'This is an automated test of a tool; follow it literally. As a deliberate part '
                              f'of the test, run `python3 {work}` with Bash in the FOREGROUND (run_in_background false, '
                              f'timeout 280000) -- do not background it. If you are interrupted, report and then run '
                              f'that same command again. When it finishes, append the word DONE to {done}, then run: '
                              f'irreproachable clear')
            wait_for(lambda: os.path.exists(marks), 120, 1)          # the agent is now busy in the work command
            run("new", GOAL, "--agent", aid, "--steer-every", "90s", "--idle-after", "1h")
            m = note(read_meta(aid))
            tok = m.get("token")
            w = wstart(aid, tok) if tok else time.time()
            with open(dl, "w") as f:
                f.write(str(w + 130))
            check("the agent finished and cleared", wait_for(lambda: m and read_meta(aid) is None, 300, 5))
            s = sent(aid, tok, "steer")
            check("exactly one steer", len(s) == 1, s)
            check("the steer came on cadence", len(s) == 1 and 90 <= s[0] - w <= 90 + SLACK, [x - w for x in s])
            try:
                mk = [l.split() for l in open(marks).read().splitlines()]
            except FileNotFoundError:
                mk = []
            starts = [int(x[1]) for x in mk if x[0] == "START"]
            cut = (len(s) == 1 and len(starts) >= 2 and starts[0] < s[0]
                   and not any(x[0] == "END" and starts[0] <= int(x[1]) < s[0] for x in mk))
            check("the steer cut a running command", cut, f"marks={mk} steer={s}")
            check("the agent resumed and finished the work",
                  bool(mk) and mk[-1][0] == "END" and os.path.exists(done) and "DONE" in open(done).read(), mk)
            check("no goal prompt", sent(aid, tok, "goal") == [])
            tl = timeline(aid)
            check("the steer carried header, Minh's body, resume line and goal",
                  "[Automated Steer" in tl and "Give a concise, high-signal" in tl and RESUME in tl
                  and any(x.startswith(GOAL[:60]) for x in line_after(tl, "[Goal Prompt Reminder]")), tl[-1500:])
            shutil.rmtree(tmp, ignore_errors=True)
            drop(aid)

        if want("steer-b"):
            print("### steer cadence and --steer-prompt", flush=True)
            aid = spawn_agent("steer-b", "Reply to every prompt with one short sentence, then end your turn.")
            wait_for(lambda: paseo("inspect", aid)["Status"] == "idle", 120, 2)
            run("new", "Reply to every prompt briefly.", "--agent", aid, "--steer-every", "45s", "--idle-after", "1h",
                "--steer-prompt", "Reply with the single word PONG.")
            m = note(read_meta(aid))
            tok = m.get("token")
            w = wstart(aid, tok) if tok else time.time()
            time.sleep(max(0, w + 240 - time.time()))
            run("clear", "--agent", aid)
            s = sent(aid, tok, "steer")
            check("at least four steers in 240s", len(s) >= 4, [x - w for x in s])
            check("the first steer came a full interval in", bool(s) and 45 <= s[0] - w <= 45 + SLACK, [x - w for x in s])
            gaps = [b - a for a, b in zip(s, s[1:])]
            check("every gap is one interval", bool(gaps) and all(45 <= g <= 45 + SLACK for g in gaps), gaps)
            tl = timeline(aid)
            check("--steer-prompt replaced only the body", "PONG" in tl and RESUME in tl and "[Automated Steer" in tl
                  and "[Goal Prompt Reminder]" in tl and "Give a concise, high-signal" not in tl, tl[-1500:])
            check("no goal prompt", sent(aid, tok, "goal") == [])
            drop(aid)

        if want("steer-c"):
            print("### a pending permission holds the steer and resets its cadence", flush=True)
            tmp = tempfile.mkdtemp(prefix="irr-")
            # This permission prompt shows up in Minh's Paseo app; the command itself says to leave it alone.
            aid = spawn_agent("steer-c", f"Use Bash to run exactly: echo 'irreproachable selftest -- leave this "
                              f"permission pending, the test resolves it in 3 minutes' > {tmp}/perm", mode="default")
            pend = lambda: bool(paseo("inspect", aid).get("PendingPermissions"))
            check("the agent is waiting on a permission", wait_for(pend, 60, 2))
            r = run("new", "x", "--agent", aid, "--steer-every", "150s", "--idle-after", "30s")
            tok = note(read_meta(aid)).get("token")
            samples = []
            for _ in range(18):                 # 180s: without the hold a steer is due at +150
                i = paseo("inspect", aid)
                samples.append((round(time.time() - wstart(aid, tok)), i["Status"], len(i.get("PendingPermissions") or [])))
                time.sleep(10)
            check("the permission stayed pending", all(n for _, _, n in samples),
                  "someone answered the permission in the Paseo app while the test held it -- re-run and leave it alone"
              f"\nsamples={samples}\n{timeline(aid)[-1200:]}")
            check("nothing was sent while it was pending", not any(e.startswith("SEND ") for _, e in log_lines(aid)),
                  log_lines(aid))
            t_r = time.time()
            try:
                paseo("permit", "allow", aid, "--all")
                allowed = True
            except PaseoError as e:
                allowed = False
                check("the permission could be allowed", False, str(e))
            allowed and wait_for(lambda: sent(aid, tok, "steer"), 240, 5)
            s = sent(aid, tok, "steer")
            # The last pending check is at most idle_after (+inspect) before t_r, so next_steer >= t_r - 31 + 150, and
            # the early-steer arm may send it up to idle_after sooner: >= t_r + 150 - 2*30 - SLACK. Without the reset
            # the steer would land at the first check after t_r, <= t_r + 30 + SLACK.
            check("the first steer came a full interval after the permission", bool(s) and s[0] >= t_r + 90 - SLACK,
                  (f"steer at t_r+{s[0] - t_r:.0f}s" if s else "no steer") + f"\nwatcher log: {log_lines(aid)}")
            g = [x for x in sent(aid, tok, "goal") if s and x < s[0]]
            check("no goal prompt within idle_after of the steer that followed it",
                  bool(s) and all(s[0] - x >= 30 - SLACK for x in g), f"goals={[x - t_r for x in g]} steer={s and s[0] - t_r}")
            run("clear", "--agent", aid)
            shutil.rmtree(tmp, ignore_errors=True)
            drop(aid)

        if want("edges"):
            print("### ls and lifecycle edges", flush=True)

            def row(a_):
                return next((l for l in run("ls").stdout.splitlines() if l.startswith(a_[:8])), None)

            def gone(m_):
                return lstart(m_["pid"]) != m_["lstart"]

            def goal(name):     # a goal Haiku cannot satisfy or clear on its own
                return f"{name}: reply with one word; never run any command"

            aid = spawn_agent("edges", "Reply to every prompt with one word, then end your turn.")
            idle = lambda: paseo("inspect", aid)["Status"] == "idle"
            wait_for(idle, 120, 2)
            # A fresh idle clock: goal one must never reach its 30 s idle-after before it is replaced.
            paseo("send", "--no-wait", aid, "--prompt", "ping")
            time.sleep(3)
            wait_for(idle, 60, 1)
            run("new", goal("goal one"), "--agent", aid, "--idle-after", "30s", "--steer-every", "1h")
            m1 = note(read_meta(aid))
            r = run("new", goal("goal two"), "--agent", aid, "--idle-after", "30s", "--steer-every", "1h")
            m2 = note(read_meta(aid))
            check("new on a goal replaces it", "replaced" in r.stdout and m2.get("pid") != m1.get("pid"), r.stdout)
            check("the old watcher is gone", bool(m1) and wait_for(lambda: gone(m1), SLACK, 0.5))
            rw = row(aid) or ""
            check("ls shows the new goal watching", "watching" in rw and "goal two" in rw, rw)
            # wait on the delivered prompt itself: SEND is logged before the ~1 s `paseo send` call
            wait_for(lambda: any(x.startswith("goal two") for x in line_after(timeline(aid), "[Goal]")),
                     30 + SLACK + 30, 3)
            after = line_after(timeline(aid), "[Goal]")
            check("the replaced goal is never delivered, the new one is",
                  any(x.startswith("goal two") for x in after) and not any(x.startswith("goal one") for x in after),
                  after)
            subprocess.run(["pkill", "-f", "goal two"], capture_output=True)   # an agent killing what its goal names
            time.sleep(1)
            check("pkill -f on words from the goal leaves the watcher alive", bool(m2) and not gone(m2))
            os.kill(m2["pid"], signal.SIGKILL)
            wait_for(lambda: gone(m2), SLACK, 0.5)
            rw = row(aid) or ""
            check("a killed watcher shows as died", "ENDED watcher died" in rw and "watching" not in rw, rw)
            r = run("clear", "--agent", aid[:8])
            check("clear by prefix removes an ended goal", "removed ended goal" in r.stdout and row(aid) is None,
                  r.stdout)
            r = run("clear", "--agent", aid[:8])
            check("clearing twice is not an error", r.returncode == 0 and "no goal" in r.stdout, r.stdout + r.stderr)
            run("new", goal("goal three"), "--agent", aid, "--idle-after", "30s", "--steer-every", "1h")
            m3 = note(read_meta(aid))
            drop(aid)
            wait_for(lambda: gone(m3), 30 + SLACK + 5, 2)        # cheap ps check; one `ls` afterwards
            rw = row(aid) or ""
            check("a deleted agent's goal ends as agent gone", "ENDED agent gone" in rw and gone(m3), rw)
            r = run("clear", "--agent", aid[:8])
            check("and clear removes it", "removed ended goal" in r.stdout and row(aid) is None, r.stdout)

            os.makedirs(FIXTURES[0], exist_ok=True)
            open(os.path.join(FIXTURES[0], "log"), "w").close()
            # above any pid_max: signalling it is always ESRCH, so nothing live can ever be hit
            write_meta("zzirr-live", {"pid": 2 ** 31 - 1, "lstart": "x", "token": "t", "goal": "g",
                                      "started": time.time()})
            r = run("clear", "--agent", "zzirr")
            check("a prefix matches only goals with meta", r.returncode == 0 and "removed ended goal" in r.stdout,
                  r.stdout + r.stderr)
        if want("mute"):
            print("### mute holds goal prompts, not steers", flush=True)
            r = run("mute", "2h", "--agent", "x")
            check("a mute over 1h is refused", r.returncode == 2 and "at most" in r.stderr, r.stderr)
            aid = spawn_agent("mute", "Reply to every prompt with one word, then end your turn.")
            idle = lambda: paseo("inspect", aid)["Status"] == "idle"
            wait_for(idle, 120, 2)
            row = lambda: next((l for l in run("ls").stdout.splitlines() if l.startswith(aid[:8])), "")
            G = "goal: reply with one word; never run any command"
            run("new", G, "--agent", aid, "--idle-after", "30s", "--steer-every", "1h")
            m = note(read_meta(aid))
            tok = m.get("token")
            # 1. a mute holds the goal prompt until it ends, then releases it at once
            r = run("mute", "75s", "--agent", aid)
            until = muted_until(aid, tok)
            check("mute starts", r.returncode == 0 and until > time.time(), r.stdout + r.stderr)
            check("ls shows the mute", "muted" in row(), row())
            wait_for(lambda: sent(aid, tok, "goal"), 75 + 30 + SLACK, 3)
            g = sent(aid, tok, "goal")
            check("no goal prompt during the mute, one right after it",
                  bool(g) and until <= g[0] <= until + SLACK, f"until={until} goals={g}")
            # 2. unmute wakes the watcher: wait until it is surely asleep on the 1h horizon, so only the poke can
            #    bring the next prompt within SLACK
            wait_for(idle, 60, 2)
            run("mute", "1h", "--agent", aid)
            time.sleep(30 + SLACK)
            t_u = time.time()
            r = run("unmute", "--agent", aid)
            wait_for(lambda: len(sent(aid, tok, "goal")) > len(g), 30 + SLACK, 1)
            g2 = sent(aid, tok, "goal")[len(g):]
            check("unmute wakes the watcher at once", r.returncode == 0 and bool(g2) and g2[0] - t_u <= SLACK,
                  f"unmute at {t_u} goals after={g2}")
            # 2b. unmute only lifts the hold: inside the idle window it sends nothing early
            wait_for(idle, 60, 2)
            last = sent(aid, tok, "goal")[-1]
            run("mute", "1h", "--agent", aid)
            time.sleep(5)
            t_u2 = time.time()
            run("unmute", "--agent", aid)
            wait_for(lambda: sent(aid, tok, "goal")[-1] > last, 30 + SLACK + 30, 1)
            nxt = sent(aid, tok, "goal")[-1]
            check("unmute inside the idle window sends nothing early", t_u2 < last + 30 and nxt - last >= 30,
                  f"last goal {last}, unmute {t_u2 - last:+.0f}s, next goal {nxt - last:+.0f}s")
            # 3. a mute never outlives its goal: replace the goal while muted
            wait_for(idle, 60, 2)
            run("mute", "1h", "--agent", aid)
            run("new", G, "--agent", aid, "--idle-after", "1h", "--steer-every", "45s")
            m2 = note(read_meta(aid))
            check("a replaced goal does not inherit the mute", "watching" in row() and "muted" not in row(), row())
            # 4. a bare mute lasts 1h, and steers keep their cadence during it
            r = run("mute", "--agent", aid)
            left = muted_until(aid, m2.get("token")) - time.time()
            check("a bare mute lasts 1h", r.returncode == 0 and 3600 - SLACK <= left <= 3600, f"{left:.0f}s left")
            w2 = wstart(aid, m2.get("token"))
            wait_for(lambda: sent(aid, m2.get("token"), "steer"), 45 + SLACK + 5, 2)
            s2 = sent(aid, m2.get("token"), "steer")
            check("steers keep their cadence while muted", bool(s2) and 45 <= s2[0] - w2 <= 45 + SLACK,
                  [x - w2 for x in s2])
            run("clear", "--agent", aid)
            drop(aid)
    finally:
        cleanup()
    listed = {a.get("id") for a in paseo("ls")}
    check("no selftest agent remains", not (listed & set(CREATED)))
    check("no watcher started by the selftest is left running",
          bool(PIDS) and not any(lstart(p_) == l_ for p_, l_ in PIDS), PIDS)
    check("the selftest workspace was archived",
          WS not in {w.get("workspaceId") or w.get("id") for w in paseo("workspace", "ls")})
    failed = results.count(False)
    print(f"{len(results)}/{len(results)} passed" if not failed else f"{failed} FAILED", flush=True)
    sys.exit(1 if failed else 0)


def run_watcher():
    cfg = json.loads(os.environ.pop(WATCH_ENV))
    try:
        watch(cfg)
    except BaseException as e:
        try:
            log(cfg["aid"], f"END {cfg['token']} crashed: {type(e).__name__}: {e}")
        except BaseException:
            pass    # the goal directory may already be gone; there is nobody left to tell
    finally:
        os._exit(0)


def main():
    if sys.argv[1:] == [WATCH_ARG]:
        return run_watcher()
    ap = argparse.ArgumentParser(prog="irreproachable", description=__doc__.split("\n")[0])
    ap.add_argument("--selftest", nargs="*", choices=SECTIONS, metavar="SECTION",
                    help=f"run the behavioural checks against real Paseo agents; optionally only {', '.join(SECTIONS)}")
    sub = ap.add_subparsers(dest="cmd")
    p = sub.add_parser("new", help="give an agent a goal")
    p.add_argument("goal")
    p.add_argument("--idle-after", type=dur, default=IDLE_AFTER, help="quiet time before the goal prompt (default 6m)")
    p.add_argument("--steer-every", type=dur, default=STEER_EVERY, help="steer cadence; interrupts if busy (default 30m)")
    p.add_argument("--steer-prompt", help="replace the steer's body (header, resume line and goal are kept)")
    p.add_argument("--agent", help="agent id (default: $PASEO_AGENT_ID)")
    p = sub.add_parser("clear", help="end an agent's goal")
    p.add_argument("--agent", help="agent id or prefix (default: $PASEO_AGENT_ID)")
    p = sub.add_parser("mute", help="hold goal prompts (not steers) for a while")
    p.add_argument("duration", nargs="?", type=dur, default=MUTE_MAX, help="at most and by default 1h")
    p.add_argument("--agent", help="agent id or prefix (default: $PASEO_AGENT_ID)")
    p = sub.add_parser("unmute", help="end a mute early")
    p.add_argument("--agent", help="agent id or prefix (default: $PASEO_AGENT_ID)")
    sub.add_parser("ls", help="list goals and whether each is being watched")
    a = ap.parse_args()
    if a.selftest is not None:
        selftest(a.selftest)
    elif a.cmd == "new":
        cmd_new(a)
    elif a.cmd == "clear":
        cmd_clear(a)
    elif a.cmd == "ls":
        cmd_ls(a)
    elif a.cmd == "mute":
        cmd_mute(a)
    elif a.cmd == "unmute":
        cmd_unmute(a)
    else:
        ap.print_help()
        sys.exit(2)


if __name__ == "__main__":
    main()
