# msv2 — desktop-group ⌘⇥ switcher. Root-owned GUI app; a demonlock compiled-default spare (com.minh.msv2),
# so it needs no explicit registration — just deploy root-owned and demonlock spares it.
APP_TYPE=gui-app
APP_NAME=msv2
BUNDLE=msv2.app
BUNDLE_ID=com.minh.msv2
TEAM_ID=BULCQM9J2V
CLI=msv2
CLI_EXEC=msv2
SPARED=no    # a compiled-in default spare; no user registration needed

provide_bundle() { dl_swift_bundle msv2.app; }

post_install() { sudo -u "$(dl_user)" open "/Applications/$BUNDLE" 2>/dev/null || true; }
