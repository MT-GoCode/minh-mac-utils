#!/bin/bash
#
# nextdns-lockdown — control + diagnostics for NextDNS Lockdown (profile-mode).
#
#   nextdns-lockdown status     show current enforcement state            (any user)
#   nextdns-lockdown selftest   actively probe real bypass vectors        (any user)
#   nextdns-lockdown arm        turn enforcement ON                       (root/sudo)
#   nextdns-lockdown disarm     turn enforcement OFF                      (root/sudo)
#   nextdns-lockdown reload     re-validate + reload the pf ruleset        (root/sudo)
#
# The resolver is the macOS Encrypted-DNS profile (DoH to NextDNS). This tool
# only manages the bypass WALL (pf). Captive portals work automatically (plain
# DNS to private/LAN ranges is always allowed) — there is NO travel mode.
#
# Privileged subcommands require root; admin is gated by sudome — that
# delay is the whole point (see README).

set -u

STATE="/Library/Application Support/NextDNSLockdown"
ARMED="$STATE/armed"
ETC="/usr/local/etc/nextdns-lockdown"
CONF="$ETC/nextdns-lockdown.conf"
LABEL="com.nextdnslockdown.enforcerd"
PROFILE_PLIST="/Library/Managed Preferences/com.apple.dnsSettings.managed.plist"

c_red=$'\033[31m'; c_grn=$'\033[32m'; c_yel=$'\033[33m'; c_dim=$'\033[2m'; c_rst=$'\033[0m'
ok()   { printf '  %sPASS%s %s\n' "$c_grn" "$c_rst" "$*"; }
bad()  { printf '  %sFAIL%s %s\n' "$c_red" "$c_rst" "$*"; }
note() { printf '  %s%s%s\n' "$c_dim" "$*" "$c_rst"; }

need_root() {
    if [ "$(id -u)" != 0 ]; then
        echo "error: '$1' requires root:  sudo nextdns-lockdown $1" >&2
        echo "(sudo needs admin, which sudome gates — that delay is intentional.)" >&2
        exit 1
    fi
}

is_armed()        { [ -f "$ARMED" ]; }
pf_enabled()      { pfctl -s info 2>/dev/null | grep -q 'Status: Enabled'; }
pf_ours_loaded()  { pfctl -sr   2>/dev/null | grep -q 'nextdns-lockdown-dns53'; }
profile_present() { [ -f "$PROFILE_PLIST" ]; }
nudge_daemon()    { launchctl kickstart -k "system/$LABEL" >/dev/null 2>&1; }
profile_url()     { plutil -extract DNSSettings.ServerURL raw "$PROFILE_PLIST" 2>/dev/null; }
# Resolution through the SYSTEM resolver (mDNSResponder -> DoH), not via dig.
resolves_system() { dscacheutil -q host -a name "${1:-apple.com}" 2>/dev/null | grep -q 'ip_address'; }

cmd_status() {
    echo "== NextDNS Lockdown (profile-mode) =="
    is_armed       && echo "  state:        ARMED (enforcing)" || echo "  state:        disarmed"
    pf_enabled     && echo "  pf:           enabled"           || echo "  pf:           disabled"
    pf_ours_loaded && echo "  pf rules:     loaded"            || echo "  pf rules:     not loaded"
    if profile_present; then
        echo "  DoH profile:  installed"
        printf '  DoH server:   %s\n' "$(profile_url)"
    else
        printf '  DoH profile:  %sMISSING%s  (no encrypted resolver — arm is refused)\n' "$c_red" "$c_rst"
    fi
    resolves_system && echo "  resolution:   working" || echo "  resolution:   NOT resolving"
    if launchctl print "system/$LABEL" >/dev/null 2>&1; then echo "  daemon:       loaded"; else echo "  daemon:       NOT loaded"; fi
}

# Probe the real bypass vectors and report OPEN / CLOSED vs the armed state.
cmd_selftest() {
    local armed_now; is_armed && armed_now=1 || armed_now=0
    echo "== NextDNS Lockdown self-test =="
    if [ "$armed_now" = 1 ]; then note "state ARMED  -> bypass vectors should be CLOSED"; else
        note "state DISARMED -> bypass vectors will be OPEN (expected when off)"; fi
    echo

    local r
    # 1) plain DNS to a public resolver
    r="$(dig +time=3 +tries=1 @8.8.8.8 example.com +short 2>/dev/null | head -1)"
    if [ -z "$r" ]; then ok "plain DNS to 8.8.8.8 is blocked"; else
        if [ "$armed_now" = 1 ]; then bad "plain DNS to 8.8.8.8 LEAKS -> $r"; else note "plain DNS to 8.8.8.8 open ($r)"; fi; fi

    # 2) plain DNS to 1.1.1.1
    r="$(dig +time=3 +tries=1 @1.1.1.1 example.com +short 2>/dev/null | head -1)"
    if [ -z "$r" ]; then ok "plain DNS to 1.1.1.1 is blocked"; else
        if [ "$armed_now" = 1 ]; then bad "plain DNS to 1.1.1.1 LEAKS -> $r"; else note "plain DNS to 1.1.1.1 open ($r)"; fi; fi

    # 3) DoH over HTTPS to a literal IP
    r="$(curl -s --max-time 6 -H 'accept: application/dns-json' 'https://1.1.1.1/dns-query?name=example.com&type=A' 2>/dev/null)"
    if [ -z "$r" ]; then ok "DoH to https://1.1.1.1 is blocked"; else
        if [ "$armed_now" = 1 ]; then bad "DoH to https://1.1.1.1 LEAKS"; else note "DoH to https://1.1.1.1 open"; fi; fi

    # 4) DoT port 853 reachability
    if nc -z -G 3 -w 3 1.1.1.1 853 >/dev/null 2>&1; then
        if [ "$armed_now" = 1 ]; then bad "DoT 853 to 1.1.1.1 reachable"; else note "DoT 853 to 1.1.1.1 reachable (open)"; fi
    else ok "DoT 853 to 1.1.1.1 is blocked"; fi

    # 5) the Encrypted-DNS profile IS the resolver now — it must be present
    if profile_present; then ok "Encrypted-DNS profile installed ($(profile_url))"; else
        bad "Encrypted-DNS profile MISSING — install the NextDNS .mobileconfig"; fi

    # 6) browser-native DoH — each browser bypasses the system resolver via its OWN
    #    policy domain, so check every known browser that is actually installed.
    local entry app rest dom lbl v
    for entry in \
        "/Applications/Google Chrome.app|com.google.Chrome|Chrome" \
        "/Applications/Google Chrome Beta.app|com.google.Chrome.beta|Chrome Beta" \
        "/Applications/Google Chrome Dev.app|com.google.Chrome.dev|Chrome Dev" \
        "/Applications/Google Chrome Canary.app|com.google.Chrome.canary|Chrome Canary" \
        "/Applications/Microsoft Edge.app|com.microsoft.Edge|Edge" \
        "/Applications/Microsoft Edge Beta.app|com.microsoft.Edge.Beta|Edge Beta" \
        "/Applications/Microsoft Edge Dev.app|com.microsoft.Edge.Dev|Edge Dev" \
        "/Applications/Microsoft Edge Canary.app|com.microsoft.Edge.Canary|Edge Canary" \
        "/Applications/Brave Browser.app|com.brave.Browser|Brave" \
        "/Applications/Vivaldi.app|com.vivaldi.Vivaldi|Vivaldi" \
        "/Applications/Opera.app|com.operasoftware.Opera|Opera" \
        "/Applications/Arc.app|company.thebrowser.Browser|Arc"; do
        app="${entry%%|*}"; rest="${entry#*|}"; dom="${rest%%|*}"; lbl="${rest#*|}"
        [ -d "$app" ] || continue
        v="$(defaults read "/Library/Managed Preferences/$dom" DnsOverHttpsMode 2>/dev/null)"
        [ "$v" = off ] && ok "$lbl Secure DNS forced off (policy)" \
            || bad "$lbl installed but Secure-DNS policy NOT set — install/extend no-browser-doh.mobileconfig"
    done
    # Firefox uses a different policy key (DNSOverHTTPS dict, not DnsOverHttpsMode).
    if [ -d "/Applications/Firefox.app" ]; then
        if defaults read "/Library/Managed Preferences/org.mozilla.firefox" DNSOverHTTPS 2>/dev/null | grep -q 'Enabled = 0'; then
            ok "Firefox DoH off (locked policy)"
        else bad "Firefox installed but DoH policy NOT set — install no-browser-doh.mobileconfig"; fi
    fi

    # 7) sanity: resolution still works through the system resolver
    if resolves_system; then ok "normal resolution works (system resolver)"; else
        bad "system resolution failed — DNS may be down (or mid captive-portal login)"; fi

    echo
    note "Verify filtering itself in a browser: https://test.nextdns.io should show profile cf7b93."
    note "Run from a fresh shell; some apps cache DNS. 'curl --max-time' waits are normal."
}

cmd_arm() {
    need_root arm
    # Safety: arming blocks every public DNS path. The ONLY remaining resolver is
    # the Encrypted-DNS profile's DoH. If that profile isn't installed (or DNS
    # isn't resolving), arming would cause a total outage. Refuse — fail-closed.
    if ! profile_present; then
        echo "✗ refusing to arm: the NextDNS Encrypted-DNS profile is not installed." >&2
        echo "  Install it first (it shows under System Settings > General > Device Management):" >&2
        echo "    open '$ETC/profile.mobileconfig'   # or the NextDNS .mobileconfig from apple.nextdns.io" >&2
        echo "  Confirm with: nextdns-lockdown status   — then re-run \`sudo nextdns-lockdown arm\`." >&2
        exit 1
    fi
    if ! resolves_system; then
        echo "✗ refusing to arm: DNS isn't resolving right now (mid captive-portal login?)." >&2
        echo "  Get online normally first, confirm a website loads, then arm." >&2
        exit 1
    fi
    mkdir -p "$STATE"; : >"$ARMED"; chmod 644 "$ARMED"; chown root:wheel "$ARMED" 2>/dev/null
    nudge_daemon
    echo "ARMED. Enforcement re-asserts within a few seconds."
    echo "Verify with:  nextdns-lockdown selftest"
}

cmd_disarm() {
    need_root disarm
    rm -f "$ARMED"
    # Tear down NOW rather than waiting for the watchdog tick, so disarm works
    # even if the daemon is stopped or wedged. Daemon (if running) sees the missing
    # 'armed' flag and stays hands-off.
    pfctl -t local_dns -T flush >/dev/null 2>&1 || true
    pfctl -f /etc/pf.conf       >/dev/null 2>&1 || true
    pfctl -d                    >/dev/null 2>&1 || true
    nudge_daemon
    echo "Disarmed — pf restored to macOS defaults now (not on a delay)."
    echo "The NextDNS Encrypted-DNS profile is untouched, so DNS keeps being filtered."
}

cmd_reload() {
    need_root reload
    if ! pfctl -n -f "$CONF"; then echo "ruleset FAILED validation — not reloaded" >&2; exit 1; fi
    pfctl -f "$CONF" >/dev/null 2>&1
    pfctl -e >/dev/null 2>&1 || true
    echo "Ruleset re-validated and reloaded."
}

case "${1:-status}" in
    status)        cmd_status ;;
    selftest|test) cmd_selftest ;;
    arm)           cmd_arm ;;
    disarm)        cmd_disarm ;;
    reload)        cmd_reload ;;
    *) echo "usage: nextdns-lockdown {status|selftest|arm|disarm|reload}" >&2; exit 1 ;;
esac
