#!/bin/bash
#
# nextdns-lockdown-probe — captive-portal / DNS diagnostic logger.
#
# Fires on every network change (via a user LaunchAgent, see install-probe.sh)
# and captures a BURST of full snapshots over ~45s — so it records the whole
# join -> captive-detect -> login -> cleared evolution, not just one instant.
# Everything lands on disk with timestamps so a failure can be diagnosed after
# the fact ("come back and ask if something failed"). Standalone bash + base-OS.
#
# Logs:   ~/Library/Logs/nextdns-captive-probe/probe-YYYY-MM-DD.log
# Recent: nextdns-lockdown-probe tail        (or: tail -f the file above)
# One-off snapshot:  nextdns-lockdown-probe once
# Full burst now:    nextdns-lockdown-probe          (default; what the agent runs)
#
# Retention: files older than 1 day are deleted on each run.

set -u

LOGDIR="$HOME/Library/Logs/nextdns-captive-probe"
LOGFILE="$LOGDIR/probe-$(date '+%Y-%m-%d').log"
LOCK="${TMPDIR:-/tmp}/nextdns-lockdown-probe.lock"
DAEMON_LOG="/var/log/nextdns-lockdown.log"
ARMED_FILE="/Library/Application Support/NextDNSLockdown/armed"
PROFILE_PLIST="/Library/Managed Preferences/com.apple.dnsSettings.managed.plist"
DOH_ANYCAST="45.90.28.0"                 # NextDNS anycast — 443 reachability probe
HOTSPOT_URL="http://captive.apple.com/hotspot-detect.html"   # macOS's own captive probe
SUCCESS_URL="https://www.apple.com/library/test/success.html"
PROBE_NAME="captive.apple.com"
# Snapshot offsets (seconds) within a burst — dense early to catch the join, then
# spaced out to catch detect/login/cleared.
OFFSETS=(0 3 6 10 15 22 30 45)

mkdir -p "$LOGDIR" 2>/dev/null
# Retention: drop anything older than 1 day.
find "$LOGDIR" -name 'probe-*.log' -type f -mtime +1 -delete 2>/dev/null

# ---- helpers ----------------------------------------------------------------
ts()  { date '+%Y-%m-%dT%H:%M:%S%z'; }
ep()  { date '+%s'; }

primary_if() { route -n get default 2>/dev/null | awk '/interface:/{print $2; exit}'; }
gw4()        { route -n get default 2>/dev/null | awk '/gateway:/{print $2; exit}'; }
gw6()        { route -n get -inet6 default 2>/dev/null | awk '/gateway:/{print $2; exit}'; }
ssid()       {
    # Several methods across macOS versions; first non-empty wins.
    local s
    s=$(ipconfig getsummary "$(primary_if)" 2>/dev/null | awk -F' : ' '/[^A-Za-z]SSID/{print $2; exit}')
    [ -z "$s" ] && s=$(networksetup -getairportnetwork "$(primary_if)" 2>/dev/null | sed 's/^Current Wi-Fi Network: //; /not associated/d')
    printf '%s' "${s:-?}"
}
resolvers() {  # learned plaintext resolvers, loopback/zone stripped
    scutil --dns 2>/dev/null | awk '/nameserver\[/{print $3}' \
      | sed 's/%.*//' | grep -vE '^(127\.|::1$)' | sort -u
}
first_v4() { resolvers | grep -E '^[0-9]+\.' | head -1; }
first_v6() { resolvers | grep ':' | head -1; }

dig_test() {  # $1 = resolver (empty = system default). echoes OK / FAIL / NODNS
    local server="$1" out
    command -v dig >/dev/null 2>&1 || { echo "NODIG"; return; }
    if [ -n "$server" ]; then
        out=$(dig +time=3 +tries=1 @"$server" "$PROBE_NAME" A +short 2>/dev/null)
    else
        out=$(dig +time=3 +tries=1 "$PROBE_NAME" A +short 2>/dev/null)
    fi
    [ -n "$out" ] && echo OK || echo FAIL
}

hotspot_state() {  # what macOS's captive probe sees: SUCCESS / PORTAL / FAIL
    local body
    body=$(curl -s -m 8 "$HOTSPOT_URL" 2>/dev/null)
    if [ -z "$body" ]; then echo FAIL
    elif printf '%s' "$body" | grep -qi '>Success<'; then echo SUCCESS
    else echo PORTAL; fi
}

doh443() { nc -z -G 4 "$DOH_ANYCAST" 443 >/dev/null 2>&1 && echo open || echo BLOCKED; }
armed()   { [ -f "$ARMED_FILE" ] && echo yes || echo no; }
profile() { [ -f "$PROFILE_PLIST" ] && echo yes || echo no; }

# ---- one full snapshot ------------------------------------------------------
snapshot() {  # $1 = index, $2 = trigger, $3 = t+offset label
    local idx="$1" trig="$2" toff="$3"
    local pif gw_4 gw_6 ss r4 r6 d_sys d_v4 d_v6 hs doh am pf

    pif=$(primary_if); gw_4=$(gw4); gw_6=$(gw6); ss=$(ssid)
    r4=$(first_v4); r6=$(first_v6)
    d_sys=$(dig_test ""); d_v4=$(dig_test "$r4"); d_v6=$(dig_test "$r6")
    hs=$(hotspot_state); doh=$(doh443); am=$(armed); pf=$(profile)

    {
        echo "========== SNAPSHOT #$idx  $(ts) (epoch=$(ep)) trigger=$trig $toff =========="
        echo "--- SUMMARY ---"
        echo "ssid=$ss  if=$pif  gw4=$gw_4  gw6=$gw_6"
        echo "resolvers: v4=$r4  v6=$r6"
        echo "dig $PROBE_NAME: system=$d_sys  via_v4=$d_v4  via_v6=$d_v6"
        echo "captive(hotspot-detect)=$hs  DoH:443=$doh  armed=$am  profile=$pf"
        echo "--- network: routes ---"
        route -n get default 2>&1 | sed 's/^/  /'
        route -n get -inet6 default 2>&1 | sed 's/^/  /'
        echo "--- network: interface $pif ---"
        ifconfig "$pif" 2>&1 | sed 's/^/  /'
        echo "--- network: routing table (top) ---"
        netstat -rn 2>/dev/null | sed -n '1,18p' | sed 's/^/  /'
        echo "--- dns: scutil --dns ---"
        scutil --dns 2>&1 | sed 's/^/  /'
        echo "--- dns: /etc/resolv.conf ---"
        cat /etc/resolv.conf 2>&1 | sed 's/^/  /'
        echo "--- captive: curl -v $HOTSPOT_URL ---"
        curl -sv -m 8 "$HOTSPOT_URL" 2>&1 | sed 's/^/  /'
        echo "--- captive: curl head $SUCCESS_URL ---"
        curl -s -m 8 -o /dev/null -w '  http=%{http_code} redirects=%{num_redirects} time=%{time_total}s remote_ip=%{remote_ip}\n' -L --max-redirs 0 "$SUCCESS_URL" 2>&1
        echo "--- dig: $PROBE_NAME per resolver ---"
        local r
        for r in $(resolvers); do
            echo "  @ $r:"
            dig +time=3 +tries=1 @"$r" "$PROBE_NAME" 2>&1 | grep -E '^(;; (ANSWER|Query time|connection timed)|captive|[0-9])' | sed 's/^/    /'
        done
        echo "  @ system:"
        dig +time=3 +tries=1 "$PROBE_NAME" 2>&1 | grep -E '^(;; (ANSWER|Query time|connection timed)|captive|[0-9])' | sed 's/^/    /'
        echo "--- reachability: ping gw + DoH anycast ---"
        [ -n "$gw_4" ] && ping -c 2 -t 3 "$gw_4" 2>&1 | sed 's/^/  /'
        echo "  DoH $DOH_ANYCAST:443 = $doh"
        echo "--- pf: local_dns table (needs root; may be empty here) ---"
        pfctl -t local_dns -T show 2>/dev/null | sed 's/^/  /' || echo "  (no access / pf not loaded)"
        echo "--- daemon log tail (cross-reference) ---"
        tail -n 6 "$DAEMON_LOG" 2>/dev/null | sed 's/^/  /' || echo "  (no daemon log)"
        echo
    } >>"$LOGFILE" 2>&1
}

# ---- modes ------------------------------------------------------------------
case "${1:-burst}" in
    tail) exec tail -n 200 -f "$LOGFILE" ;;
    once) snapshot 1 "manual-once" "t+0s"; echo "logged -> $LOGFILE"; exit 0 ;;
esac

# burst (default; what the LaunchAgent runs on network change)
# Single-flight: if a burst is already running, skip (don't stack on rapid changes).
if ! mkdir "$LOCK" 2>/dev/null; then exit 0; fi
trap 'rmdir "$LOCK" 2>/dev/null' EXIT INT TERM

TRIG="${PROBE_TRIGGER:-network-change}"
{ echo; echo "########## BURST START $(ts) trigger=$TRIG ##########"; } >>"$LOGFILE" 2>&1
i=0; prev=0
for off in "${OFFSETS[@]}"; do
    wait=$(( off - prev )); [ "$wait" -gt 0 ] && sleep "$wait"
    prev="$off"; i=$(( i + 1 ))
    snapshot "$i" "$TRIG" "t+${off}s"
done
{ echo "########## BURST END   $(ts) ##########"; } >>"$LOGFILE" 2>&1
