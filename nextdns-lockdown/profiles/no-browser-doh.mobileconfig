        <key>PayloadUUID</key><string>7B3C1A90-0001-4000-8000-000000000007</string>
        <key>PayloadDisplayName</key><string>Edge Beta — Secure DNS off</string>
        <key>PayloadVersion</key><integer>1</integer>
        <key>DnsOverHttpsMode</key><string>off</string>
        <key>BuiltInDnsClientEnabled</key><false/>
      </dict>
      <dict>
        <key>PayloadType</key><string>com.microsoft.Edge.Dev</string>
        <key>PayloadIdentifier</key><string>com.minh.nextdnslockdown.nobrowserdoh.edge-dev</string>
        <key>PayloadUUID</key><string>7B3C1A90-0001-4000-8000-000000000008</string>
        <key>PayloadDisplayName</key><string>Edge Dev — Secure DNS off</string>
        <key>PayloadVersion</key><integer>1</integer>
        <key>DnsOverHttpsMode</key><string>off</string>
        <key>BuiltInDnsClientEnabled</key><false/>
      </dict>
      <dict>
        <key>PayloadType</key><string>com.microsoft.Edge.Canary</string>
        <key>PayloadIdentifier</key><string>com.minh.nextdnslockdown.nobrowserdoh.edge-canary</string>
        <key>PayloadUUID</key><string>7B3C1A90-0001-4000-8000-000000000009</string>
        <key>PayloadDisplayName</key><string>Edge Canary — Secure DNS off</string>
        <key>PayloadVersion</key><integer>1</integer>
        <key>DnsOverHttpsMode</key><string>off</string>
        <key>BuiltInDnsClientEnabled</key><false/>
      </dict>
      <dict>
        <key>PayloadType</key><string>com.brave.Browser</string>
        <key>PayloadIdentifier</key><string>com.minh.nextdnslockdown.nobrowserdoh.brave</string>
        <key>PayloadUUID</key><string>7B3C1A90-0001-4000-8000-00000000000A</string>
        <key>PayloadDisplayName</key><string>Brave — Secure DNS off</string>
        <key>PayloadVersion</key><integer>1</integer>
        <key>DnsOverHttpsMode</key><string>off</string>
        <key>BuiltInDnsClientEnabled</key><false/>
      </dict>
      <dict>
        <key>PayloadType</key><string>com.vivaldi.Vivaldi</string>
        <key>PayloadIdentifier</key><string>com.minh.nextdnslockdown.nobrowserdoh.vivaldi</string>
        <key>PayloadUUID</key><string>7B3C1A90-0001-4000-8000-00000000000B</string>
        <key>PayloadDisplayName</key><string>Vivaldi — Secure DNS off</string>
        <key>PayloadVersion</key><integer>1</integer>
        <key>DnsOverHttpsMode</key><string>off</string>
        <key>BuiltInDnsClientEnabled</key><false/>
      </dict>
      <dict>
        <key>PayloadType</key><string>com.operasoftware.Opera</string>
        <key>PayloadIdentifier</key><string>com.minh.nextdnslockdown.nobrowserdoh.opera</string>
        <key>PayloadUUID</key><string>7B3C1A90-0001-4000-8000-00000000000C</string>
        <key>PayloadDisplayName</key><string>Opera — Secure DNS off</string>
        <key>PayloadVersion</key><integer>1</integer>
        <key>DnsOverHttpsMode</key><string>off</string>
        <key>BuiltInDnsClientEnabled</key><false/>
      </dict>
      <dict>
        <key>PayloadType</key><string>company.thebrowser.Browser</string>
        <key>PayloadIdentifier</key><string>com.minh.nextdnslockdown.nobrowserdoh.arc</string>
        <key>PayloadUUID</key><string>7B3C1A90-0001-4000-8000-00000000000D</string>
        <key>PayloadDisplayName</key><string>Arc — Secure DNS off</string>
        <key>PayloadVersion</key><integer>1</integer>
        <key>DnsOverHttpsMode</key><string>off</string>
        <key>BuiltInDnsClientEnabled</key><false/>
      </dict>
      <dict>
        <key>PayloadType</key><string>org.mozilla.firefox</string>
        <key>PayloadIdentifier</key><string>com.minh.nextdnslockdown.nobrowserdoh.firefox</string>
        <key>PayloadUUID</key><string>7B3C1A90-0001-4000-8000-00000000000E</string>
        <key>PayloadDisplayName</key><string>Firefox — DoH off (locked)</string>
        <key>PayloadVersion</key><integer>1</integer>
        <key>DNSOverHTTPS</key>
        <dict>
          <key>Enabled</key><false/>
          <key>Locked</key><true/>
        </dict>
      </dict>
    </array>
  </dict>
</plist>
