#!/usr/bin/env python3
"""pacemaker — turn a silent long-running command into one that pings you.

Meant to be run BY Monitor, which executes it and turns every line it prints into a
notification. It works in a plain shell but then it is talking to nobody.

    Monitor(pacemaker --slug build -- make -j8)        a job
    Monitor(pacemaker --slug ci --every 120)           a bare reminder, no command
    Monitor(pacemaker --slug build --attach)           resume after Monitor expires

Under 60 seconds it says nothing at all and then hands back the whole result, so it is a
drop-in for running the command directly. Past 60 seconds it starts reporting.

The job is double-forked and reparented to init, because this harness kills the process
TREE when a Monitor expires -- a new session alone is not enough while pacemaker is still
the parent (measured: the job died). pacemaker also stays out of the job's data path: the
job writes straight to its own files and pacemaker only reads them, so killing pacemaker
can never SIGPIPE the job.

Python rather than shell because shell cannot do this portably: POSIX sh has no `read -t`,
`stat -c` is GNU-only, and `date -d`, `timeout`, `flock` and `setsid` are all missing on
macOS. A shell poll loop also costs ~14,400 forks an hour.
"""
import argparse, collections, json, os, shlex, shutil, signal, sys, time

HOME = os.path.expanduser("~/.pacemaker")

EVERY_DEFAULT = 75        # Minh's number
EVERY_MAX     = 300       # Minh's number
TIMEOUT_MAX   = 1800      # nothing may outlive Monitor's own ceiling
QUIET_START   = 60        # below this a job is a pass-through, so say nothing at all
SETTLE        = 1.5       # a burst has stopped when nothing new arrives for this long
POLL          = 1.0       # must be under SETTLE or settling cannot be detected
HUNG_AFTER    = 300       # 5 minutes of silence is worth asking about
LINES         = 50        # per stream per emission
HEAD          = 10        # of those, from the front: a burst's phase markers live there
COLS          = 200       # one runaway line is not the whole notification
CHUNK         = 65536     # most we read from either end of a delta in one poll
PRUNE_DAYS    = 7
PRUNE_BYTES   = 500 * 1024 * 1024


def short(p):
    """~ for the home directory. Shorter in a notification, and identical on every
    machine -- so a path quoted in the doctrine is true on a Mac and on Linux alike."""
    h = os.path.expanduser("~")
    return "~" + p[len(h):] if p.startswith(h + os.sep) else p


def fmt(sec):
    sec = int(sec)
    h, m, s = sec // 3600, (sec % 3600) // 60, sec % 60
    return f"{h}h{m:02d}m{s:02d}s" if h else (f"{m}m{s:02d}s" if m else f"{s}s")


def emit(*parts):
    """One flush per emission: Monitor batches stdout within 200ms into a single event.

    Parts are joined verbatim -- an empty one is a blank line the job actually printed, and
    filtering those out silently edits the output we were asked to relay."""
    sys.stdout.write("\n".join(parts) + "\n")
    sys.stdout.flush()


class Run:
    def __init__(self, slug):
        self.slug = slug
        self.dir  = os.path.join(HOME, slug)
        self.out  = os.path.join(self.dir, "stdout")
        self.err  = os.path.join(self.dir, "stderr")
        self.exit = os.path.join(self.dir, "exit")
        self.meta = os.path.join(self.dir, "meta")

    def exists(self):    return os.path.isdir(self.dir)
    def read_meta(self): return json.load(open(self.meta))

    def last_write(self):
        """When either log last grew, or None. On --attach this is the only honest answer
        to 'how long has it been quiet' -- the watcher was not here for the silence.

        Empty files are ignored. An untouched stderr still has an mtime, and counting it
        would date the last write to whenever the file was created."""
        t = None
        for p in (self.out, self.err):
            try:
                if os.path.getsize(p):
                    t = max(t or 0, os.path.getmtime(p))
            except OSError:
                pass
        return t

    def exit_code(self):
        """None until the job finishes. Written by the job's own shell, so it is there
        even for a run nobody was watching."""
        try:
            t = open(self.exit).read().strip()
            return int(t) if t else None
        except (OSError, ValueError):
            return None

    @staticmethod
    def alive(pid):
        try:
            os.kill(pid, 0)
            return True
        except OSError:
            return False

    def start(self, cmd):
        if self.exists():
            try:
                m = self.read_meta()
            except (OSError, ValueError):
                m = {}                      # a half-written meta is not a reason to refuse
            old = m.get("pid")
            if self.exit_code() is None and isinstance(old, int) and self.alive(old):
                sys.exit(f"pacemaker: '{self.slug}' is already running (pid {old}). "
                         f"Use --attach, or pick another --slug.")
            stamp = time.strftime("%Y%m%d-%H%M%S",
                                  time.localtime(m.get("started") or time.time()))
            dest, n = f"{self.dir}-{stamp}", 1
            while os.path.exists(dest):     # moving onto an existing dir nests inside it
                dest, n = f"{self.dir}-{stamp}.{n}", n + 1
            shutil.move(self.dir, dest)     # keep the old run's logs
        os.makedirs(self.dir)

        # stdbuf line-buffers libc programs; PYTHONUNBUFFERED covers Python, which stdbuf
        # cannot touch. Without both, a healthy job writes nothing for minutes and reads
        # as hung.
        env = dict(os.environ, PYTHONUNBUFFERED="1")
        # shlex.quote throughout: joining argv with plain spaces destroys the caller's
        # quoting, turning `sh -c 'sleep 60'` into `sh -c sleep` with 60 as $0.
        inner = (f"{cmd} > {shlex.quote(self.out)} 2> {shlex.quote(self.err)}; "
                 f"echo $? > {shlex.quote(self.exit)}")
        argv = ["sh", "-c", inner]
        if shutil.which("stdbuf"):
            argv = ["stdbuf", "-oL", "-eL"] + argv

        # Double fork. A new session alone does NOT survive this harness: it kills the
        # process tree at Monitor expiry and reaches the job through pacemaker whatever
        # session it is in. Letting the middle process exit reparents the job to init
        # before any kill exists. setsid runs in the grandchild so it is its own group
        # leader and os.killpg on its pid reaches the whole job later.
        pidfile = os.path.join(self.dir, "pid")
        mid = os.fork()
        if mid == 0:
            try:
                gc = os.fork()
                if gc == 0:
                    os.setsid()
                    fd = os.open(os.devnull, os.O_RDWR)
                    os.dup2(fd, 0); os.dup2(fd, 1); os.dup2(fd, 2)
                    try:
                        os.execvpe(argv[0], argv, env)
                    finally:
                        os._exit(127)   # exec failed: must NOT fall through and write pid 0,
                                        # which later becomes killpg(0) -- our own group
                with open(pidfile, "w") as f:
                    f.write(str(gc))
            finally:
                os._exit(0)
        os.waitpid(mid, 0)

        for _ in range(500):
            try:
                pid = int(open(pidfile).read())
                if pid <= 1:
                    raise ValueError
                break
            except (OSError, ValueError):
                time.sleep(0.01)
        else:
            sys.exit("pacemaker: the job never reported a pid")

        json.dump({"pid": pid, "started": time.time(), "cmd": cmd}, open(self.meta, "w"))
        return pid

    def kill(self, pid):
        """Negative pid: the job is its own group leader, so this reaches the shell AND
        the command under it. Killing the pid alone orphans the command, unstoppably."""
        for sig in (signal.SIGTERM, signal.SIGKILL):
            try:
                os.killpg(pid, sig)
            except OSError:
                return
            for _ in range(50):
                if not self.alive(pid):
                    return
                time.sleep(0.1)


def prune():
    """Only ever touch finished runs. A directory's mtime does not advance when a file
    inside it is appended to, so an age rule alone deletes LIVE runs -- and a job whose
    directory is gone keeps writing into an unlinked inode and can never signal that it
    finished."""
    if not os.path.isdir(HOME):
        return
    done = []
    for name in os.listdir(HOME):
        d, e = os.path.join(HOME, name), os.path.join(HOME, name, "exit")
        try:
            if not (os.path.isdir(d) and os.path.exists(e)):
                continue
            size = 0
            for f in os.listdir(d):
                f = os.path.join(d, f)
                if os.path.isfile(f):
                    size += os.path.getsize(f)
            done.append((os.path.getmtime(e), d, size))
        except OSError:
            continue        # it vanished under us; pruning it is already someone else's job
    now   = time.time()
    total = sum(s for _, _, s in done)
    for mt, d, size in sorted(done):
        if now - mt > PRUNE_DAYS * 86400 or total > PRUNE_BYTES:
            shutil.rmtree(d, ignore_errors=True)
            total -= size


def listing():
    """Finished runs are only reachable by --attach while they still hold the live slot;
    once the slug is reused the old one is archived under its start time. Without a listing
    they are invisible."""
    if not os.path.isdir(HOME):
        return
    rows = []
    for name in sorted(os.listdir(HOME)):
        d = os.path.join(HOME, name)
        if not os.path.isdir(d):
            continue
        try:
            m = json.load(open(os.path.join(d, "meta")))
            started = float(m["started"])
        except (OSError, ValueError, KeyError, TypeError):
            continue        # no meta, or a half-written one: skip the row, not the listing
        pid  = m.get("pid")
        code = Run(name).exit_code()
        if code is not None:
            state = f"exit {code}"
        elif isinstance(pid, int) and Run.alive(pid):
            state = "RUNNING"
        else:
            state = "died"
        rows.append((started, name, state, str(m.get("cmd", ""))))
    if not rows:
        print("no runs under " + short(HOME))
        return
    for started, name, state, cmd in sorted(rows):
        print(f"{time.strftime('%Y-%m-%d %H:%M', time.localtime(started))}  "
              f"{state:<9} {name:<24} {cmd[:60]}")
    print(f"\nlogs: {short(HOME)}/<name>/stdout and /stderr")


def read_delta(path, off):
    """Return (head_text, tail_text, skipped_bytes), new_offset, warning.

    Reads at most 2*CHUNK regardless of how much arrived. A job can write a gigabyte
    between two polls; reading `size - off` would pull all of it into memory, which on a
    4GB box is how the watcher becomes the outage. We only ever DISPLAY the first and last
    few lines, so only the first and last CHUNK are worth reading."""
    try:
        size = os.path.getsize(path)
    except OSError:
        return ("", "", 0), off, "missing"
    if size < off:
        return ("", "", 0), 0, "truncated"
    if size == off:
        return ("", "", 0), size, None
    n = size - off
    try:
        with open(path, "rb") as f:
            if n <= 2 * CHUNK:
                f.seek(off)
                head, tail, skipped = f.read(n), b"", 0
            else:
                f.seek(off)
                head = f.read(CHUNK)
                f.seek(size - CHUNK)
                tail = f.read(CHUNK)
                skipped = n - 2 * CHUNK
    except OSError:
        return ("", "", 0), off, "unreadable"
    d = lambda b: b.decode("utf-8", "replace").replace("\x00", "")
    return (d(head), d(tail), skipped), size, None


class Stream:
    """What one stream wrote since the last emission, in bounded space.

    Holds the first HEAD lines and the last LINES-HEAD lines and nothing in between, so
    memory is ~LINES*COLS no matter how loud the job is. Counting is exact until a poll
    has to skip bytes, after which it is a floor and says so."""

    def __init__(self, label, path):
        self.label, self.path = label, short(path)
        self.reset()

    def reset(self):
        self.head = []
        self.tail = collections.deque(maxlen=max(1, LINES - HEAD))
        self.count = 0
        self.skipped = 0
        self.partial = ""

    def feed(self, head_text, tail_text, skipped):
        self._lines(head_text)
        if skipped:
            # What follows is not contiguous with what we just read, so the line still open
            # can never be completed -- close it rather than splicing two halves together.
            self.skipped += skipped
            if self.partial:
                self._add(self.partial)
                self.partial = ""
        if tail_text:
            self._lines(tail_text)

    def _lines(self, text):
        if not text:
            return
        # A bare \r is a line break here. Progress bars (pip, curl, cargo) redraw with \r and
        # emit no newline for minutes; without this the open fragment is a growing megabyte
        # whose first 200 characters -- the FIRST progress update -- are all anyone ever sees.
        text = text.replace("\r\n", "\n").replace("\r", "\n")
        parts = (self.partial + text).split("\n")
        self.partial = parts.pop()    # "" if it ended on a newline, else the open fragment
        # Only the first COLS characters of the fragment are ever displayed, and _add would
        # cut it there anyway, so holding the rest of a line that never ends is pure leak.
        self.partial = self.partial[:COLS]
        for ln in parts:
            self._add(ln)             # a blank line is a line; only the trailing "" is not

    def _add(self, ln):
        self.count += 1
        if len(self.head) < HEAD:
            self.head.append(ln[:COLS])
        else:
            self.tail.append(ln[:COLS])

    def empty(self):
        return self.count == 0 and not self.partial

    def render(self):
        if self.empty():
            return []
        shown = self.head + list(self.tail)
        lost = []
        if self.count > len(shown):
            n = self.count - len(shown)
            lost.append(f"{n} line{'s' if n != 1 else ''} omitted")
        if self.skipped:
            lost.append(f"{max(1, self.skipped // 1024)}KB never read")
        if lost:
            out = self.head + [f"... {' and '.join(lost)}, full log at {self.path} ..."] \
                            + list(self.tail)
        else:
            out = shown
        if self.partial:
            out.append(self.partial[:COLS])
        return ([f"{self.label}:"] if self.label else []) + out


def drain(run, so, se, oo, eo):
    """One last read. The job's shell writes `exit` only after the command's output is
    already in the files, but our read happened a tick earlier -- without this the final
    lines of a short command can be lost, which is exactly the kind of green-and-wrong
    this tool exists to prevent."""
    (h, tl, sk), oo, _ = read_delta(run.out, oo); so.feed(h, tl, sk)
    (h, tl, sk), eo, _ = read_delta(run.err, eo); se.feed(h, tl, sk)
    return oo, eo


def finish(run, started, code, so, se, paths=False):
    tail = f" Full logs: {short(run.out)} and {short(run.err)}" if paths else ""
    emit(f"{run.slug} completed in {fmt(time.time()-started)} with exit code {code}.{tail}",
         *so.render(), *se.render())


def watch(run, every, timeout, attaching):
    try:
        m = run.read_meta()
        pid, started, cmd = int(m["pid"]), float(m["started"]), str(m.get("cmd", ""))
    except (OSError, ValueError, KeyError, TypeError):
        sys.exit(f"pacemaker: '{run.slug}' has no readable meta. Anything it wrote is "
                 f"under {short(run.dir)}")
    floor = every / 3                 # at most three emissions per heartbeat interval
    so = Stream(None, run.out)        # stdout is unlabelled, Minh's format
    se = Stream("stderr", run.err)
    oo = eo = 0

    if attaching:
        code = run.exit_code()
        if code is not None:
            (h, tl, sk), _, _ = read_delta(run.out, 0); so.feed(h, tl, sk)
            (h, tl, sk), _, _ = read_delta(run.err, 0); se.feed(h, tl, sk)
            finish(run, started, code, so, se, paths=True)
            return
        if not run.alive(pid):
            emit(f"{run.slug} is gone and never recorded an exit code — killed, OOM, or the "
                 f"machine rebooted. Logs: {short(run.out)} and {short(run.err)}")
            return
        (h, tl, sk), oo, _ = read_delta(run.out, 0); so.feed(h, tl, sk)
        (h, tl, sk), eo, _ = read_delta(run.err, 0); se.feed(h, tl, sk)
        emit(f"Re-attached to {run.slug} — {cmd} — running for {fmt(time.time()-started)}. "
             f"Below is what it has written so far; full logs at {short(run.out)} and "
             f"{short(run.err)}.",
             *so.render(), *se.render())
        so.reset(); se.reset()

    # Not time.time(): on --attach the job may have been silent for twenty minutes before
    # we arrived, and starting the clock here would report that as "Quiet for 30s".
    last_emit = time.time()
    last_change = run.last_write() or started
    while True:
        time.sleep(POLL)
        now = time.time()

        (h, tl, sk), oo, ow = read_delta(run.out, oo)
        (h2, tl2, sk2), eo, ew = read_delta(run.err, eo)
        if h or tl or sk or h2 or tl2 or sk2:    # bytes arrived; counting lines would miss
            last_change = now                    # a lone newline closing an open fragment
        so.feed(h, tl, sk)
        se.feed(h2, tl2, sk2)

        code = run.exit_code()
        if code is not None:
            drain(run, so, se, oo, eo)      # the job wrote its last bytes before `exit`
            finish(run, started, code, so, se)
            return
        if not run.alive(pid):
            drain(run, so, se, oo, eo)
            emit(f"{run.slug} died after {fmt(now-started)} with no exit code — killed, OOM, "
                 f"or out of disk. Logs: {short(run.out)} and {short(run.err)}",
                 *so.render(), *se.render())
            return
        if timeout and now - started > timeout:
            run.kill(pid)
            drain(run, so, se, oo, eo)
            try:
                with open(run.exit, "w") as f:
                    f.write("124")                   # the code timeout(1) uses
            except OSError:
                pass
            emit(f"{run.slug} hit --timeout {timeout}s and was killed after {fmt(now-started)}.",
                 *so.render(), *se.render())
            return

        # Silent for the first minute: below that a job is a pass-through and the
        # completion line says everything there is to say.
        if now - started < QUIET_START:
            continue

        pending = not (so.empty() and se.empty())
        quiet = now - last_change
        due = (pending and quiet >= SETTLE and now - last_emit >= floor) or (now - last_emit >= every)
        if not due:
            continue

        head = f"Heartbeat. {run.slug} running for {fmt(now-started)}."
        if not pending:
            if quiet < 0:
                # Never clamp this to 0. A clamp turns a clock-skewed machine into a job
                # that reports itself healthy forever, which is the failure this tool exists
                # to catch.
                head += (f" The log's timestamp is {fmt(-quiet)} in the future, so quiet "
                         f"time cannot be measured on this machine.")
            else:
                head += f" Quiet for {fmt(quiet)}."
                if quiet >= HUNG_AFTER:
                    head += " Is this hung, or is there a problem?"
        for w, name in ((ow, "stdout"), (ew, "stderr")):
            if w:
                head += f" ({name} was {w})"
        emit(head, *so.render(), *se.render())
        so.reset(); se.reset()
        last_emit = now


def remind(slug, every, timeout):
    """No pid, no logs, nothing to lose -- so nothing to detach and nothing to resume.

    Deliberately stateless. The elapsed figure is therefore since THIS arming, not since
    the thing you are waiting on began, and it says so: Monitor expires at 30 minutes, so
    a re-armed reminder would otherwise quietly restart its clock and understate the wait."""
    start = time.time()
    while True:
        time.sleep(every)
        now = time.time()
        if timeout and now - start > timeout:
            emit(f"Reminder for {slug} stopped after --timeout {timeout}s.")
            return
        emit(f"Heartbeat. Reminder to check on {slug} — {fmt(now - start)} since this "
             f"reminder was armed.")


def selftest():
    """Behavioural checks, run against this very file, from outside the process.

    In the tool and not beside it, so `pacemaker --selftest` works on any machine where
    pacemaker is installed -- no repo, no second file to copy. Every bug that actually
    shipped here was invisible to unit-style checking: argv quoting destroyed, output
    eaten on polls that did not emit, a job dying with the Monitor because a new session
    alone does not survive a process-tree kill. So these drive the real binary."""
    import ast, glob, re, subprocess
    ME = [sys.executable, os.path.abspath(__file__)]
    P = {"n": 0, "f": 0}

    def ok(m):  P["n"] += 1; print(f"  \033[32m✓\033[0m {m}")
    def no(m):  P["f"] += 1; print(f"  \033[31m✗\033[0m {m}")
    def check(cond, msg, detail=""):
        ok(msg) if cond else no(f"{msg} — {detail}" if detail else msg)

    def pm(*args, timeout=120):
        p = subprocess.Popen(ME + list(args), stdout=subprocess.PIPE,
                             stderr=subprocess.STDOUT, text=True)
        try:
            out = p.communicate(timeout=timeout)[0]
        except subprocess.TimeoutExpired:
            p.kill(); out = p.communicate()[0]
        return p.returncode, out

    def bg(*args):
        return subprocess.Popen(ME + list(args), stdout=subprocess.DEVNULL,
                                stderr=subprocess.DEVNULL)

    def watch_for(seconds, *args):
        """Run a watcher that will not exit on its own, and read what it said."""
        p = subprocess.Popen(ME + list(args), stdout=subprocess.PIPE,
                             stderr=subprocess.STDOUT, text=True)
        try:
            out = p.communicate(timeout=seconds)[0]
        except subprocess.TimeoutExpired:
            p.kill(); out = p.communicate()[0]
        return out

    def clean(slug):
        for d in [os.path.join(HOME, slug)] + glob.glob(os.path.join(HOME, slug + "-*")):
            shutil.rmtree(d, ignore_errors=True)

    def job_pid(slug):
        try:    return json.load(open(os.path.join(HOME, slug, "meta")))["pid"]
        except Exception: return None

    def kill_job(slug):
        pid = job_pid(slug)
        if pid:
            try: os.killpg(pid, signal.SIGKILL)
            except OSError: pass

    def stage(slug, age, log_offset, pid):
        """A run that has been going for `age` seconds whose log last grew at
        now+log_offset. Costs seconds instead of the ten minutes it describes."""
        d = os.path.join(HOME, slug)
        os.makedirs(d, exist_ok=True)
        open(os.path.join(d, "stdout"), "w").write("old output\n")
        open(os.path.join(d, "stderr"), "w").close()
        now = time.time()
        json.dump({"pid": pid, "started": now - age, "cmd": "sleep 20"},
                  open(os.path.join(d, "meta"), "w"))
        os.utime(os.path.join(d, "stdout"), (now + log_offset, now + log_offset))

    S = "selftest_"
    print(f"pacemaker --selftest  ({os.path.abspath(__file__)})")

    # ---------------------------------------------------------------- pass-through
    clean(S + "quick")
    rc, out = pm("--slug", S + "quick", "--", "sh", "-c",
                 "echo hello; echo oops >&2; exit 3")
    check("completed in" in out and "with exit code 3" in out,
          "a short job reports its real exit code", out[:80])
    check(re.search(r"^hello$", out, re.M), "stdout is passed through unlabelled")
    check(re.search(r"^stderr:$", out, re.M) and re.search(r"^oops$", out, re.M),
          "stderr is passed through, labelled")
    check("Heartbeat" not in out, "a sub-60s job stays silent")
    clean(S + "quick")

    # ---------------------------------------------------------------- truncation
    clean(S + "trunc")
    _, out = pm("--slug", S + "trunc", "--", "sh", "-c",
                "for i in $(seq 1 70); do echo \"line $i\"; done")
    check("lines omitted" in out, "a long burst is truncated")
    check(re.search(r"full log at .*" + S + r"trunc/stdout", out),
          "truncation says where the full log is")
    check(re.search(r"^line 1$", out, re.M), "truncation keeps the head")
    check(re.search(r"^line 70$", out, re.M), "truncation keeps the tail")
    clean(S + "trunc")

    # ---------------------------------------------------------------- volume
    # Reading `size - offset` pulled a whole delta into memory; on a 4GB box the watcher
    # becomes the outage. Bounded now -- prove it from outside.
    clean(S + "loud")
    _, out = pm("--slug", S + "loud", "--", "sh", "-c",
                "yes abcdefghij | head -c 5000000")
    check(len(out) < 20000, "5MB of output yields a small notification", f"{len(out)} bytes")
    check("never read" in out, "it says how much it skipped rather than pretending")
    check(re.search(r"full log at .*" + S + r"loud/stdout", out),
          "the skip points at the full log")
    check(os.path.getsize(os.path.join(HOME, S + "loud", "stdout")) == 5000000,
          "the log itself keeps all 5MB")
    clean(S + "loud")

    # ---------------------------------------------------------------- fidelity
    clean(S + "fid")
    _, out = pm("--slug", S + "fid", "--", "sh", "-c",
                "echo a; echo; echo b; printf no-newline")
    check(re.search(r"^a$\n^$\n^b$", out, re.M), "a blank line in the middle is kept")
    check(re.search(r"^no-newline$", out, re.M), "a final line with no newline still shows")
    clean(S + "fid")

    clean(S + "last")
    _, out = pm("--slug", S + "last", "--", "sh", "-c", "sleep 1; echo FINAL")
    check(re.search(r"^FINAL$", out, re.M), "output written just before exit is not lost")
    clean(S + "last")

    clean(S + "cr")
    _, out = pm("--slug", S + "cr", "--", "sh", "-c",
                'printf "7%%\\r14%%\\r100%% done\\n"')
    check(re.search(r"^100% done$", out, re.M),
          "a \\r progress bar shows its latest state, not its first", out[:120])
    clean(S + "cr")

    clean(S + "long")
    _, out = pm("--slug", S + "long", "--", "python3", "-c",
                'import sys; sys.stdout.write("z"*300000)')
    longest = max((len(x) for x in out.splitlines()), default=0)
    check(longest <= 200, "a 300KB line with no newline is cut at 200 columns", str(longest))
    clean(S + "long")

    # ---------------------------------------------------------------- quoting
    clean(S + "quote")
    _, out = pm("--slug", S + "quote", "--", "sh", "-c", 'printf "%s\\n" "a b c"')
    check(re.search(r"^a b c$", out, re.M),
          "argv quoting survives (sh -c with spaces)", out[:80])
    clean(S + "quote")

    # ---------------------------------------------------------------- corrupt meta
    clean(S + "bad")
    pm("--slug", S + "bad", "--", "sh", "-c", "echo x")
    open(os.path.join(HOME, S + "bad", "meta"), "w").write('{"pid": nope')
    rc, out = pm("--list")
    check(rc == 0 and "Traceback" not in out, "--list survives a half-written meta", out[:80])
    _, out = pm("--slug", S + "bad", "--attach")
    check("Traceback" not in out, "attach on a bad meta fails cleanly", out[:80])
    _, out = pm("--slug", S + "bad", "--", "sh", "-c", "echo again")
    check(re.search(r"^again$", out, re.M),
          "a bad meta does not block a new run on that slug", out[:80])
    clean(S + "bad")

    # ---------------------------------------------------------------- detachment
    clean(S + "surv")
    p = bg("--slug", S + "surv", "--every", "300", "--", "sh", "-c", "sleep 25")
    time.sleep(3)
    jp = job_pid(S + "surv")
    ppid = subprocess.run(["ps", "-o", "ppid=", "-p", str(jp)],
                          capture_output=True, text=True).stdout.strip()
    check(ppid == "1", "job is reparented to init (ppid 1), not a child of pacemaker",
          f"ppid is {ppid!r} — a tree kill would reach it")
    p.kill(); p.wait(); time.sleep(2)
    check(Run.alive(jp), "job survives pacemaker being killed")

    out = watch_for(4, "--slug", S + "surv", "--attach", "--every", "300")
    check("Re-attached to " + S + "surv" in out, "attach resumes a live run by slug alone",
          out[:100])
    check("running for" in out, "attach reports elapsed from the original start")
    kill_job(S + "surv"); clean(S + "surv")

    _, out = pm("--slug", S + "nosuch", "--attach")
    check("no run named" in out, "attach to a missing run says so", out[:80])

    clean(S + "ctx")
    p = bg("--slug", S + "ctx", "--every", "300", "--", "sh", "-c",
           "echo EARLYLINE; sleep 30")
    time.sleep(3)
    out = watch_for(4, "--slug", S + "ctx", "--attach", "--every", "300")
    check("EARLYLINE" in out, "attach to a live run shows what it already wrote", out[:100])
    p.kill(); p.wait(); kill_job(S + "ctx"); clean(S + "ctx")

    # ---------------------------------------------------------------- quiet clock
    sl = subprocess.Popen(["sleep", "20"])
    clean(S + "quiet"); stage(S + "quiet", 700, -600, sl.pid)
    out = watch_for(8, "--slug", S + "quiet", "--attach", "--every", "1")
    check("Quiet for 10m" in out, "attach measures quiet from the log, not from attach time",
          next((l for l in out.splitlines() if "Heartbeat" in l), out[:80]))
    check("Is this hung" in out, "ten minutes of silence asks the question")
    clean(S + "quiet")

    # A clamp here is how the predecessor called a dead job healthy forever.
    clean(S + "skew"); stage(S + "skew", 120, 600, sl.pid)
    out = watch_for(6, "--slug", S + "skew", "--attach", "--every", "1")
    check("in the future" in out, "a future log timestamp is reported, never clamped to 0",
          next((l for l in out.splitlines() if "Heartbeat" in l), out[:80]))
    check("Quiet for" not in out, "it does not invent a quiet time it cannot measure")
    clean(S + "skew")
    sl.kill(); sl.wait()

    # ---------------------------------------------------------------- timeout
    clean(S + "tmo")
    t0 = time.time()
    _, out = pm("--slug", S + "tmo", "--every", "300", "--timeout", "3",
                "--", "sh", "-c", "sleep 120")
    took = time.time() - t0
    check("hit --timeout" in out, "timeout fires and says so", out[:80])
    check(took < 30, "timeout returns promptly", f"{took:.0f}s")
    time.sleep(1)
    check(not Run.alive(job_pid(S + "tmo") or 0),
          "--timeout killed the command, not just the wrapper")
    check(open(os.path.join(HOME, S + "tmo", "exit")).read().strip() == "124",
          "timeout records exit 124")
    clean(S + "tmo")

    clean(S + "died")
    p = subprocess.Popen(ME + ["--slug", S + "died", "--every", "300",
                               "--", "sh", "-c", "sleep 120"],
                         stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
    time.sleep(3)
    kill_job(S + "died")          # SIGKILL: the job never gets to write an exit code
    try:
        out = p.communicate(timeout=15)[0]
    except subprocess.TimeoutExpired:
        p.kill(); out = p.communicate()[0]
    check("died after" in out and "no exit code" in out,
          "a job killed from outside is reported as died, not as silence", out[:100])
    clean(S + "died")

    # ---------------------------------------------------------------- collision
    clean(S + "dup")
    p = bg("--slug", S + "dup", "--every", "300", "--", "sh", "-c", "sleep 30")
    time.sleep(2)
    _, out = pm("--slug", S + "dup", "--every", "300", "--", "sh", "-c", "echo second")
    check("already running" in out, "a second run on a live slug is refused", out[:80])
    p.kill(); p.wait(); kill_job(S + "dup"); clean(S + "dup")

    # ---------------------------------------------------------------- listing
    clean(S + "list")
    pm("--slug", S + "list", "--", "sh", "-c", "echo listed; exit 7")
    _, out = pm("--list")
    check(S + "list" in out, "--list shows a finished run")
    check("exit 7" in out, "--list shows its exit code")
    check("logs:" in out, "--list says where the logs are")
    _, out = pm("--slug", S + "list", "--attach")
    check("with exit code 7" in out, "attach replays a finished run", out[:80])
    check("Full logs:" in out, "attach names both log files")
    clean(S + "list")

    # ---------------------------------------------------------------- validation
    for args, msg in (
        (("--slug", "x", "--every", "301"),    "--every above 300 rejected"),
        (("--slug", "x", "--timeout", "1801"), "--timeout above 1800 rejected"),
        (("--every", "60"),                    "--slug is required"),
        (("--slug", "a/b"),                    "a path-like slug is rejected"),
    ):
        rc, _ = pm(*args, timeout=10)
        check(rc != 0, msg)

    # ---------------------------------------------------------------- prune safety
    # A directory's mtime does not advance when a file inside it is appended to, so an
    # age rule alone deletes LIVE runs -- and a job whose directory is gone keeps writing
    # into an unlinked inode and can never signal that it finished.
    clean(S + "live"); clean(S + "other")
    p = bg("--slug", S + "live", "--every", "300", "--", "sh", "-c", "sleep 30")
    time.sleep(2)
    old = time.time() - 400 * 86400
    os.utime(os.path.join(HOME, S + "live"), (old, old))
    pm("--slug", S + "other", "--every", "5", "--", "sh", "-c", "true")
    check(os.path.isdir(os.path.join(HOME, S + "live")),
          "prune leaves a live run alone despite an ancient mtime")
    p.kill(); p.wait(); kill_job(S + "live"); clean(S + "live"); clean(S + "other")

    # ---------------------------------------------------------------- reminder
    out = watch_for(7, "--slug", S + "rem", "--every", "2")
    check("Reminder to check on " + S + "rem" in out, "the bare reminder shape pings", out[:80])
    check(re.search(r"Reminder to check on \S+ — \d+s since this reminder was armed", out),
          "the reminder carries how long it has been armed", out[:100])
    check(not os.path.exists(os.path.join(HOME, S + "rem")), "the reminder keeps no files")

    # ---------------------------------------------------------------- portability
    # This ships to two Macs and one Linux box, and only the Linux box gets run routinely.
    # A GNU-ism reaches both Macs within the sync interval. Lint, not behaviour.
    # The marker has to be on EVERY line of the pattern, not just the last: the scan is
    # line-by-line, so a multi-line pattern otherwise reports itself.
    pat = re.compile(r"sed +-i|date +-[dr] |stat +-[cf] |readlink +-f|grep +-P|-printf"  # lint-self
                     r"|sort +-V|echo +-e|declare +-A|mapfile|readarray"                 # lint-self
                     r"|(^|[^.\w])(setsid|flock) ")                                      # lint-self
    here = os.path.dirname(os.path.abspath(__file__))
    bad = []
    for f in [os.path.abspath(__file__)] + [os.path.join(here, x) for x in
                                            ("install.sh", "uninstall.sh")]:
        if not os.path.isfile(f):
            continue
        for i, line in enumerate(open(f, errors="replace"), 1):
            s = line.strip()
            if s.startswith("#") or "lint-self" in s:
                continue
            if pat.search(line):
                bad.append(f"{os.path.basename(f)}:{i}: {s[:70]}")
    check(not bad, "no GNU-only constructs in the shipped files", "; ".join(bad))

    try:
        ast.parse(open(os.path.abspath(__file__)).read(), feature_version=(3, 8))
        ok("parses under the oldest python3 a Mac may ship (3.8)")
    except SyntaxError as e:
        no(f"needs a python3 newer than 3.8 — {e}")

    print()
    if P["f"]:
        print(f"\033[31m{P['f']} of {P['n'] + P['f']} FAILED\033[0m")
        return 1
    print(f"\033[32m{P['n']}/{P['n']} passed\033[0m")
    return 0


def main():
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--list", action="store_true", help="show every run on this machine and its state")
    ap.add_argument("--selftest", action="store_true",
                    help="run the behavioural checks against this copy")
    ap.add_argument("--slug",
                    help="names the run; you choose it, so you can always --attach")
    ap.add_argument("--every", type=int, default=EVERY_DEFAULT, help=f"seconds, max {EVERY_MAX}")
    ap.add_argument("--timeout", type=int, default=0,
                    help=f"kill the job after this many seconds, max {TIMEOUT_MAX}")
    ap.add_argument("--attach", action="store_true", help="resume watching an existing run")
    ap.add_argument("cmd", nargs=argparse.REMAINDER)
    a = ap.parse_args()

    if a.selftest:
        sys.exit(selftest())
    if a.list:
        listing()
        return
    if not a.slug:
        ap.error("--slug is required (or use --list)")
    if not 0 < a.every <= EVERY_MAX:
        sys.exit(f"pacemaker: --every must be 1..{EVERY_MAX}")
    if not 0 <= a.timeout <= TIMEOUT_MAX:
        sys.exit(f"pacemaker: --timeout must be 0..{TIMEOUT_MAX}")
    if "/" in a.slug or a.slug.startswith("."):
        sys.exit("pacemaker: --slug must be a plain name")
    cmd = a.cmd[1:] if a.cmd and a.cmd[0] == "--" else a.cmd

    os.makedirs(HOME, exist_ok=True)
    run = Run(a.slug)

    if a.attach:
        if not run.exists():
            sys.exit(f"pacemaker: no run named '{a.slug}' — it was pruned, or never started.")
        watch(run, a.every, a.timeout, attaching=True)
    elif cmd:
        prune()
        # not shlex.join: that is 3.8+, and this has to run on whatever python3
        # a given Mac or box happens to ship.
        run.start(" ".join(shlex.quote(c) for c in cmd))
        watch(run, a.every, a.timeout, attaching=False)
    else:
        remind(a.slug, a.every, a.timeout)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        pass
