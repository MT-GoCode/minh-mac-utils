<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.settingslock.guard</string>

    <!-- Root watchdog: re-bootstraps the watch agent if it gets booted out, so a
         non-admin can't just unload the detector to escape. -->
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/settingslock</string>
        <string>guard</string>
    </array>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/tmp/settingslock-guard.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/settingslock-guard.log</string>
</dict>
</plist>
