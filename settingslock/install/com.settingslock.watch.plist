<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.settingslock.watch</string>

    <!-- The detector. Must run in the user's GUI session (Accessibility/UI
         inspection doesn't work from a root daemon). -->
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/settingslock</string>
        <string>watch</string>
    </array>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/tmp/settingslock-watch.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/settingslock-watch.log</string>
</dict>
</plist>
