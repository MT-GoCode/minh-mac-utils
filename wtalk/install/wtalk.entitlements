<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- mlx runs on the GPU; the Metal driver (AGX…) JIT-compiles shaders at runtime, which the
         hardened runtime forbids unless we allow JIT / unsigned executable memory. Required or the
         daemon is SIGKILLed with "Code Signature Invalid (Invalid Page)" the moment mlx hits Metal.
         This does NOT disable library validation — bundled dylibs still must be team-signed, so it
         doesn't let anyone inject code; it only permits the app's own Metal JIT. -->
    <key>com.apple.security.cs.allow-jit</key>                        <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key> <true/>

    <!-- REQUIRED for the microphone under the hardened runtime. Without it macOS doesn't merely
         deny recording — it never even shows the consent prompt: authorizationStatus stays
         notDetermined forever, requestAccess() does nothing visible, and every capture comes back
         as digital silence. That is exactly how "wtalk stopped transcribing" presented: red dot,
         a real buffer, an empty transcript, and no way to grant the permission because no dialog
         ever appeared. NSMicrophoneUsageDescription in Info.plist is necessary but NOT sufficient;
         a hardened-runtime binary also needs this entitlement. -->
    <key>com.apple.security.device.audio-input</key>                  <true/>
</dict>
</plist>
