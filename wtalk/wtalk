#!/bin/bash
# Dev convenience shim — the REAL entry point is wtalk.py (which Nuitka freezes into
# /Applications/wtalk.app). In a dev checkout this lets `./wtalk status` still work by
# running wtalk.py under the project .venv (falling back to any python3). The installed
# binary is invoked via /usr/local/bin/wtalk → the bundle, not this file.
#
# Install/uninstall are NO LONGER subcommands here — use:  sudo ./install.sh / ./uninstall.sh
HERE="$(cd "$(dirname "$0")" && pwd)"
PY="$HERE/.venv/bin/python"
[ -x "$PY" ] || PY="$(command -v python3 || echo python3)"
exec "$PY" "$HERE/wtalk.py" "$@"
