#!/usr/bin/env python3
"""wtalk — local push-to-talk dictation. `wtalk help` for usage.

ONE always-on background daemon, managed entirely by a launchd LaunchAgent
(runs at login, kept alive). Karabiner's F5 runs `wtalk toggle`, which signals
the daemon. There is no second "manual" start path — install/restart/uninstall
all act on the same launchd agent, so its state is never ambiguous.
"""
import os
import sys

# Re-exec under the project venv so this works at ANY clone path / username (the
# shebang only needs some python3 to make this one hop). realpath resolves the
# ~/.local/bin/wtalk symlink so the venv next to the real script is found.
ROOT = os.path.dirname(os.path.realpath(__file__))
_VENV = os.path.join(ROOT, ".venv")
_VENV_PY = os.path.join(_VENV, "bin", "python")
if os.path.exists(_VENV_PY) and os.path.realpath(sys.prefix) != os.path.realpath(_VENV):
    os.execv(_VENV_PY, [_VENV_PY, os.path.realpath(__file__), *sys.argv[1:]])

import glob          # noqa: E402
import plistlib      # noqa: E402
import shutil        # noqa: E402
import signal        # noqa: E402
import subprocess    # noqa: E402
import time          # noqa: E402
from datetime import datetime  # noqa: E402

sys.path.insert(0, ROOT)
import config  # noqa: E402

_LABEL = "com.wtalk.agent"
_UID = os.getuid()
_DOMAIN = f"gui/{_UID}"
_AGENT = os.path.expanduser(f"~/Library/LaunchAgents/{_LABEL}.plist")
_APP = os.path.join(ROOT, "wtalk.app")
_APP_EXE = os.path.join(_APP, "Contents", "MacOS", "wtalk")
_DAEMON = os.path.join(ROOT, "daemon.py")
_LOGDIR = os.path.expanduser("~/.wtalk")

HELP = """wtalk — local dictation: F5 to speak, F5 again to paste a cleaned version at your cursor.

  wtalk install     build + sign the app, run at login (always-on), prompt for the 2 perms
  wtalk uninstall   stop and remove the login agent
  wtalk restart     bounce the daemon (after editing config.txt or .env)
  wtalk             status: ready / loading / not running
  wtalk status      same as bare `wtalk`
  wtalk toggle      what F5 does: start dictation; run again to stop + clean + paste
  wtalk cancel      what Esc does: cancel the current dictation
  wtalk history     last 20 dictations
  wtalk help        this message

  Trigger: F5 (bound in Karabiner -> `wtalk toggle`) or the menu-bar mic icon.
  Perms:   Microphone (record) + Accessibility (paste at cursor), both shown as 'wtalk'.
  Config:  {cfg}""".format(cfg=config.ROOT / "config.txt")


# ============================ status ============================
def _age(iso):
    if not iso:
        return "never"
    secs = (datetime.now(config.tzinfo()) - datetime.fromisoformat(iso)).total_seconds()
    if secs < 60:
        return f"{secs:.0f}s ago"
    if secs < 3600:
        return f"{secs/60:.0f}m ago"
    return f"{secs/3600:.1f}h ago"


def cmd_status():
    loaded = _agent_loaded()
    s = config.state_read()
    if not s or not config.alive(s.get("pid")):
        if loaded:
            print("◍ wtalk loading… (launchd agent up; Parakeet warming — check again in a moment)")
        else:
            print("○ wtalk not running — run 'wtalk install'")
        return
    if s.get("status") == "loading":
        print("◍ wtalk loading… (Parakeet warming up)")
        return
    line = f"● wtalk ready — mic: {s.get('mic')} · queue {s.get('queue_depth', 0)}"
    if s.get("listening"):
        line += " · LISTENING"
    elif s.get("worker_busy"):
        line += " · cleaning"
    print(line)
    hb = s.get("heartbeat")
    if hb:
        hb_age = (datetime.now(config.tzinfo()) - datetime.fromisoformat(hb)).total_seconds()
        if hb_age > 12:
            print(f"  ! heartbeat {hb_age:.0f}s stale — `wtalk restart`")
    if s.get("last_error"):
        print(f"  last error: {s['last_error']}")


# ====================== app build + signing ======================
def _daemon_env():
    """Env for launching the daemon out of wtalk.app: the bundled interpreter
    lives outside .venv, so point it at the base stdlib (PYTHONHOME) + the venv
    packages (PYTHONPATH)."""
    site = glob.glob(os.path.join(_VENV, "lib", "python*", "site-packages"))
    if not site:
        raise SystemExit("wtalk: no .venv site-packages — run ./setup.sh")
    return {"PYTHONHOME": sys.base_prefix, "PYTHONPATH": site[0], "PYTHONNOUSERSITE": "1"}


def _sign_identity():
    """Pick a codesign identity via the shared picker (../sign-identity.sh):
    Developer ID → stable self-signed → ad-hoc. Override with CODESIGN_IDENTITY."""
    forced = os.environ.get("CODESIGN_IDENTITY")
    if forced:
        return forced
    sign_sh = os.path.join(os.path.dirname(ROOT), "sign-identity.sh")
    if os.path.isfile(sign_sh):
        try:
            out = subprocess.run(["bash", sign_sh], stdout=subprocess.PIPE, text=True).stdout
            if (out or "").strip():
                return out.strip()
        except Exception:
            pass
    return "-"


def _ensure_app():
    """Build + sign wtalk.app — a REAL app bundle so macOS shows the perms as a
    clean 'wtalk'. Its executable is a copy of the interpreter; it finds the venv
    via PYTHONHOME/PYTHONPATH (see _daemon_env).

    CRITICAL: signed WITHOUT the hardened runtime. wtalk loads conda/venv C
    extensions (fcntl, numpy, sounddevice) that are NOT signed with our Team ID;
    the hardened runtime's library validation rejects those and the daemon dies
    at `import fcntl`. A plain signature (Developer ID for stable TCC grants,
    else ad-hoc) runs fine and still anchors the Microphone/Accessibility grants.
    Returns (exe_path, identity_used)."""
    os.makedirs(os.path.join(_APP, "Contents", "MacOS"), exist_ok=True)
    shutil.copy2(os.path.realpath(sys.executable), _APP_EXE)
    with open(os.path.join(_APP, "Contents", "Info.plist"), "wb") as f:
        plistlib.dump({
            "CFBundleName": "wtalk",
            "CFBundleDisplayName": "wtalk",
            "CFBundleIdentifier": "com.wtalk.daemon",
            "CFBundleExecutable": "wtalk",
            "CFBundlePackageType": "APPL",
            "CFBundleShortVersionString": "2.0",
            "LSUIElement": True,            # menu-bar app, no Dock icon
            "NSMicrophoneUsageDescription": "wtalk records your voice to transcribe it.",
        }, f)
    ident = _sign_identity()
    r = subprocess.run(["codesign", "--force", "--sign", ident,   # NO --options runtime (see above)
                        "--identifier", "com.wtalk.daemon", _APP],
                       capture_output=True, text=True)
    if r.returncode:
        print(f"WARNING: codesign failed ({(r.stderr or '').strip()[:160]}) — "
              "the app may not launch (Apple Silicon requires a signature).")
    return _APP_EXE, ident


# ====================== launchd (single mechanism) ======================
def _agent_loaded():
    return subprocess.run(["launchctl", "print", f"{_DOMAIN}/{_LABEL}"],
                          capture_output=True).returncode == 0


def _write_agent_plist(exe):
    ff = shutil.which("ffmpeg")
    path = ":".join(dict.fromkeys(filter(None, [
        os.path.dirname(ff) if ff else "", os.path.expanduser("~/.local/bin"),
        "/opt/homebrew/bin", "/usr/local/bin",
        "/usr/bin", "/bin", "/usr/sbin", "/sbin"])))   # ~/.local/bin → finds fadepause/faderesume
    os.makedirs(os.path.dirname(_AGENT), exist_ok=True)
    os.makedirs(_LOGDIR, exist_ok=True)
    with open(_AGENT, "wb") as f:
        plistlib.dump({
            "Label": _LABEL,
            "ProgramArguments": [exe, _DAEMON],
            "RunAtLoad": True,
            "KeepAlive": {"SuccessfulExit": False},   # restart on crash, not on clean stop
            "WorkingDirectory": ROOT,
            "EnvironmentVariables": {"PATH": path, **_daemon_env()},
            "StandardOutPath": os.path.join(_LOGDIR, "daemon.log"),
            "StandardErrorPath": os.path.join(_LOGDIR, "daemon.log"),
        }, f)


def _load_agent():
    """(Re)bootstrap the agent into the GUI domain. Modern launchctl, with a
    legacy load fallback for older macOS."""
    subprocess.run(["launchctl", "bootout", f"{_DOMAIN}/{_LABEL}"], capture_output=True)
    r = subprocess.run(["launchctl", "bootstrap", _DOMAIN, _AGENT], capture_output=True, text=True)
    if r.returncode != 0:
        subprocess.run(["launchctl", "unload", _AGENT], capture_output=True)
        r = subprocess.run(["launchctl", "load", "-w", _AGENT], capture_output=True, text=True)
    return r


def _prime_perms(exe):
    """Run the app once in a tiny mode that fires BOTH permission prompts
    (Accessibility dialog + Microphone dialog), attributed to 'wtalk'. Returns
    quickly; it does NOT load Parakeet."""
    subprocess.run([exe, _DAEMON, "--prime-perms"],
                   env={**os.environ, **_daemon_env()},
                   capture_output=True, text=True, timeout=30)


def cmd_install():
    if not os.environ.get("GEMINI_API_KEY"):
        print(f"⚠ No GEMINI_API_KEY in {config.ROOT/'.env'} — cleanup will paste the RAW transcript.")
        print("  Add one (https://aistudio.google.com/apikey), then re-run `wtalk install`.\n")
    exe, ident = _ensure_app()
    print("▸ requesting permissions (approve BOTH dialogs as 'wtalk')…")
    try:
        _prime_perms(exe)
    except Exception:
        pass
    _write_agent_plist(exe)
    r = _load_agent()
    if r.returncode:
        print("launchctl failed:", (r.stderr or "").strip()); return
    print(f"✓ installed — wtalk runs at login and is starting now (signed: "
          f"{'ad-hoc' if ident == '-' else ident}).")
    print("  Approve the Accessibility prompt now. NOTE: macOS often won't show the")
    print("  Microphone prompt until your FIRST dictation (first real mic use) — that's")
    print("  normal; just approve it then. Both appear as 'wtalk'.")
    print("  Then bind F5 → `wtalk toggle` in Karabiner.  Check it:  wtalk status")


def cmd_uninstall():
    subprocess.run(["launchctl", "bootout", f"{_DOMAIN}/{_LABEL}"], capture_output=True)
    subprocess.run(["launchctl", "unload", _AGENT], capture_output=True)
    try:
        os.remove(_AGENT); print("✓ uninstalled — won't start at login.")
    except FileNotFoundError:
        print("not installed.")


def cmd_restart():
    if not os.path.exists(_AGENT):
        print("not installed — run 'wtalk install'"); return
    if _agent_loaded():
        subprocess.run(["launchctl", "kickstart", "-k", f"{_DOMAIN}/{_LABEL}"], capture_output=True)
    else:
        _load_agent()
    print("restarting wtalk… (check `wtalk status`)")


# ====================== runtime signals ======================
def _signal_daemon(sig, label):
    s = config.state_read()
    if not s or not config.alive(s.get("pid")):
        print("wtalk not running — run 'wtalk install'"); return
    os.kill(int(s["pid"]), sig)
    time.sleep(0.3)
    s = config.state_read() or {}
    print(f"{label} — listening={s.get('listening')} queue={s.get('queue_depth', 0)}")


def cmd_toggle():
    _signal_daemon(signal.SIGUSR1, "→ toggled dictation")


def cmd_cancel():
    _signal_daemon(signal.SIGUSR2, "→ cancelled")


def cmd_history():
    rows = config.db_recent(20)
    if not rows:
        print("no history yet"); return
    for r in reversed(rows):
        when = (r.get("created_at") or "")[:19].replace("T", " ")
        out = (r.get("output") or r.get("transcript") or "").replace("\n", " ")
        print(f"  #{r.get('id'):<5} {when}  [{r.get('status')}]  {out[:80]}")


def main():
    a = sys.argv[1:]
    cmd = a[0] if a else "status"
    fns = {"status": cmd_status, "install": cmd_install, "uninstall": cmd_uninstall,
           "restart": cmd_restart, "toggle": cmd_toggle, "cancel": cmd_cancel,
           "history": cmd_history}
    if cmd in ("help", "-h", "--help"):
        print(HELP)
    elif cmd in fns:
        fns[cmd]()
    else:
        print(f"unknown command: {cmd}\n"); print(HELP)


if __name__ == "__main__":
    main()
